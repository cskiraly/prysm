+// is its). Nil once the router has stopped.
+func (p *PubSub) OutboundStats() map[peer.ID]OutboundStat {
+	out := make(chan map[peer.ID]OutboundStat, 1)
+	select {
+	case p.eval <- func() {
+		m := make(map[peer.ID]OutboundStat, len(p.peers))

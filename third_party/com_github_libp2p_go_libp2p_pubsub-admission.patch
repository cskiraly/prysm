--- base/hoseestimate.go	1970-01-01 01:00:00.000000000 +0100
+++ fork/hoseestimate.go	2026-10-22 13:36:32.091069297 +0200
@@ -0,0 +1,342 @@
+package pubsub
+
+import (
+	"context"
+	"math"
+	"sort"
+	"sync/atomic"
+	"time"
+)
+
+// --- The hose window from a capacity estimate: the slow form ---
+//
+// The per-ack controller cannot settle inside one message (a fast source's upload is smaller
+// than one bandwidth-delay product), so here the window is set, not stepped: W = Ĉ × (RTT + D0) /
+// frame, with Ĉ the node's uplink capacity and RTT the mean base round trip to its peers.
+//
+// Ĉ is the maximum delivery rate over a horizon of recent ticks. Two sources:
+//
+//   - Acknowledged (Delivered nil, the default): the frames the node's peers acknowledged over
+//     the last three ticks, times the frame size (three, so acknowledgements that arrive in a
+//     bunch do not read as a rate). A receiver acknowledges only what arrived, so a queue
+//     building in the uplink cannot inflate it. Most ticks the node has little to send, and such
+//     a rate is only a lower bound on the capacity: it may raise the estimate, never lower it.
+//     A tick whose acknowledgements show a queue (median queueing ≥ D0) had the link saturated,
+//     and its rate is a measurement: the maximum of those inside the horizon sets the estimate,
+//     up or down. A too-small window only measures itself, so while it binds with no queue
+//     showing -- the link has room -- the estimate grows by ProbeGain. (BBR's reasoning: probe
+//     while delivery can still rise.) A first form took every tick's rate as a measurement and
+//     read relays, which rarely fill their uplink, at half their capacity (Q133 smoke 2).
+//   - Local (LocalSaturation): the same acknowledged rate, but the node decides locally when it
+//     measures capacity, since the one saturation signal an acknowledgement carries mixes the
+//     receiver's reverse-path queue into the sender's (Q133 smoke 3). Locally a node sees only
+//     whether its window is the limit: pops waiting for a slot. So, BBR's full-pipe test: in a
+//     round (three ticks) with the window the limit throughout, grow the window by ProbeGain
+//     while the delivery rate still follows (≥ +10 percent over the last round); when it stops
+//     following, the link is full and the plateau is a measurement. A round without the window
+//     the limit is a lower bound. A prior too high never binds and is never corrected, which
+//     leaves the node as it would be without a window.
+//   - Transport (Delivered set): bytes sent less lost on every connection, counted over ticks
+//     with a writer blocked in its stream write at both ends. Kept for the record: it failed its
+//     known answer (Q133 smoke), because QUIC rarely blocks a write -- the backlog sits in the link
+//     queue, not the transport -- and bytes sent into that queue overstate delivery (up to 1.5x).
+
+// HoseEstimate turns the window's controller into a capacity estimate (HoseConfig.Estimate).
+type HoseEstimate struct {
+	Tick    time.Duration // the sampling tick (default 100 ms)
+	Horizon time.Duration // the maximum filter's reach (default 30 s)
+	// Delivered, when set, is the transport source: bytes sent less lost on every connection so
+	// far; nil takes the rate from acknowledged frames. MeanRTT is the mean base round trip.
+	Delivered  func() uint64
+	MeanRTT    func() time.Duration
+	FrameBytes int     // the mean frame the window counts
+	Prior      float64 // bytes per second before the first sample
+	ProbeGain  float64 // growth a tick while the window binds unmeasured (default 1.25)
+	// LocalSaturation takes the acknowledged rate but measures capacity only at a local
+	// plateau: the window the limit for a round and the rate no longer following it.
+	LocalSaturation bool
+	// Forward takes capacity from the stamped forward delay (hosefwd.go): runs of frames whose
+	// forward queue stays at or above ForwardQueue (default 10 ms). Every peer must stamp.
+	Forward      bool
+	ForwardQueue time.Duration
+}
+
+// hoseEstimator is the estimate's state, owned by its goroutine except where noted.
+type hoseEstimator struct {
+	cfg     HoseEstimate
+	samples []rateSample // measurements inside the horizon, oldest first
+	probe   float64      // the probing rate while unmeasured, bytes per second
+	recent  [3]int       // frames acknowledged in the last three ticks, the acknowledged source's window
+	n       int          // ticks seen, to fill recent
+
+	// The local source's round: ticks in it, whether the window was the limit in all of them, and
+	// the last limited round's rate.
+	roundTicks   int
+	roundLimited bool
+	roundRef     float64
+
+	fwdPending []fwdSample  // the forward source's frames not yet read, oldest exit first
+	floors     []rateSample // the forward source's rates measured under a binding window, lower bounds
+
+	// Observation, read by HoseEstimateStats.
+	est, last          atomic.Uint64 // math.Float64bits: the estimate in use, the last valid sample
+	valid, ticks       atomic.Int64
+	probes, measured   atomic.Int64
+	fwdSeen, fwdQueued atomic.Int64 // the forward source's frames read, and those in backlogged runs
+}
+
+type rateSample struct {
+	at   time.Time
+	rate float64
+}
+
+// estimateLoop drives the window from the estimate until ctx ends. blocked is the node's count of
+// writers inside a stream write.
+func (h *hoseWindow) estimateLoop(ctx context.Context, blocked *atomic.Int64) {
+	e := h.est
+	t := time.NewTicker(e.cfg.Tick)
+	defer t.Stop()
+	transport := e.cfg.Delivered != nil
+	var prevAt time.Time
+	var prev uint64
+	var prevBlocked bool
+	if transport {
+		prevAt, prev, prevBlocked = time.Now(), e.cfg.Delivered(), blocked.Load() > 0
+	}
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case now := <-t.C:
+			e.ticks.Add(1)
+			h.mu.Lock()
+			acks, qs := h.tickAcks, h.tickQ
+			h.tickAcks, h.tickQ = 0, nil
+			h.mu.Unlock()
+			if transport {
+				cur, isBlocked := e.cfg.Delivered(), blocked.Load() > 0
+				if isBlocked && prevBlocked && cur >= prev {
+					e.add(now, float64(cur-prev)/now.Sub(prevAt).Seconds())
+				}
+				prevAt, prev, prevBlocked = now, cur, isBlocked
+				h.applyEstimate(now, qs)
+				continue
+			}
+			e.recent[e.n%len(e.recent)] = acks
+			e.n++
+			if e.cfg.Forward {
+				h.applyForward(now)
+				continue
+			}
+			if e.cfg.LocalSaturation {
+				h.applyLocal(now)
+			} else {
+				h.applyAcked(now, qs)
+			}
+		}
+	}
+}
+
+func (e *hoseEstimator) add(now time.Time, r float64) {
+	e.samples = append(e.samples, rateSample{now, r})
+	e.valid.Add(1)
+	e.last.Store(math.Float64bits(r))
+}
+
+// applyAcked is the acknowledged source's step: the tick's rate over the last three ticks, a
+// measurement when qs shows a queue, else a lower bound; a probe when the window binds unqueued.
+func (h *hoseWindow) applyAcked(now time.Time, qs []time.Duration) {
+	e := h.est
+	r := e.ackedRate()
+	queued := len(qs) > 0 && medianDuration(qs) >= h.cfg.Target
+	if queued && r > 0 {
+		e.add(now, r)
+	}
+	cut := 0
+	for cut < len(e.samples) && now.Sub(e.samples[cut].at) > e.cfg.Horizon {
+		cut++
+	}
+	e.samples = e.samples[cut:]
+	prev := math.Float64frombits(e.est.Load())
+	rate := prev
+	if len(e.samples) > 0 {
+		measured := 0.0
+		for _, s := range e.samples {
+			measured = math.Max(measured, s.rate)
+		}
+		rate = measured
+		e.measured.Add(1)
+	}
+	rate = math.Max(rate, r) // any delivery rate is a lower bound
+	h.mu.Lock()
+	binds := len(h.waiters) > 0
+	h.mu.Unlock()
+	if binds && !queued {
+		rate = math.Max(rate, prev) * e.cfg.ProbeGain
+		e.probes.Add(1)
+	}
+	e.est.Store(math.Float64bits(rate))
+	h.setWindow(rate * (e.cfg.MeanRTT() + h.cfg.Target).Seconds() / float64(e.cfg.FrameBytes))
+}
+
+// ackedRate is the acknowledged rate over the last three ticks, bytes per second.
+func (e *hoseEstimator) ackedRate() float64 {
+	frames := 0
+	for _, a := range e.recent {
+		frames += a
+	}
+	ticks := min(e.n, len(e.recent))
+	return float64(frames*e.cfg.FrameBytes) / (float64(ticks) * e.cfg.Tick.Seconds())
+}
+
+// applyLocal is the local source's step: a lower bound each tick the window is not the limit, and
+// at the end of each round with the window the limit throughout, a probe while the rate follows
+// or a measurement at its plateau.
+func (h *hoseWindow) applyLocal(now time.Time) {
+	e := h.est
+	r := e.ackedRate()
+	h.mu.Lock()
+	binds := len(h.waiters) > 0
+	h.mu.Unlock()
+	if e.roundTicks == 0 {
+		e.roundLimited = true
+	}
+	e.roundTicks++
+	e.roundLimited = e.roundLimited && binds
+	prev := math.Float64frombits(e.est.Load())
+	rate := prev
+	probe, plateau := false, false
+	if e.roundTicks == len(e.recent) {
+		switch {
+		case !e.roundLimited:
+			e.roundRef = 0
+		case e.roundRef > 0 && r < 1.1*e.roundRef:
+			e.add(now, math.Max(r, e.roundRef)) // the plateau: the link, not the window, was the limit
+			e.roundRef, plateau = r, true
+		default:
+			probe = true // the window was the limit and the rate still followed it
+			e.roundRef = r
+		}
+		e.roundTicks = 0
+	}
+	cut := 0
+	for cut < len(e.samples) && now.Sub(e.samples[cut].at) > e.cfg.Horizon {
+		cut++
+	}
+	e.samples = e.samples[cut:]
+	if len(e.samples) > 0 {
+		measured := 0.0
+		for _, s := range e.samples {
+			measured = math.Max(measured, s.rate)
+		}
+		rate = measured
+		e.measured.Add(1)
+	}
+	if e.roundRef > 0 && !plateau {
+		rate = math.Max(rate, prev) // a probe holds its window until a round decides it
+	}
+	if !binds {
+		rate = math.Max(rate, r) // a rate the window did not hold back is a lower bound
+	}
+	if probe {
+		rate = math.Max(rate, prev) * e.cfg.ProbeGain
+		e.probes.Add(1)
+	}
+	e.est.Store(math.Float64bits(rate))
+	h.setWindow(rate * (e.cfg.MeanRTT() + h.cfg.Target).Seconds() / float64(e.cfg.FrameBytes))
+}
+
+// applyEstimate is the transport source's step: the maximum of the samples inside the horizon,
+// or a probe while the window binds unmeasured.
+func (h *hoseWindow) applyEstimate(now time.Time, _ []time.Duration) {
+	e := h.est
+	cut := 0
+	for cut < len(e.samples) && now.Sub(e.samples[cut].at) > e.cfg.Horizon {
+		cut++
+	}
+	e.samples = e.samples[cut:]
+	measured := 0.0
+	for _, s := range e.samples {
+		measured = math.Max(measured, s.rate)
+	}
+	prev := math.Float64frombits(e.est.Load())
+	h.mu.Lock()
+	binds := len(h.waiters) > 0
+	h.mu.Unlock()
+	rate := prev
+	switch {
+	case measured > 0:
+		rate = measured
+		e.measured.Add(1)
+	case binds:
+		if e.probe == 0 {
+			e.probe = prev
+		}
+		e.probe *= e.cfg.ProbeGain
+		rate = e.probe
+		e.probes.Add(1)
+	}
+	if measured > 0 {
+		e.probe = 0
+	}
+	e.est.Store(math.Float64bits(rate))
+	h.setWindow(rate * (e.cfg.MeanRTT() + h.cfg.Target).Seconds() / float64(e.cfg.FrameBytes))
+}
+
+func medianDuration(xs []time.Duration) time.Duration {
+	s := append([]time.Duration(nil), xs...)
+	sort.Slice(s, func(i, j int) bool { return s[i] < s[j] })
+	return s[len(s)/2]
+}
+
+// setWindow moves the window to w frames, inside the configured bounds, and wakes waiters.
+func (h *hoseWindow) setWindow(w float64) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.w = math.Min(h.cfg.Max, math.Max(h.cfg.Min, w))
+	h.wLo, h.wHi = math.Min(h.wLo, h.w), math.Max(h.wHi, h.w)
+	h.wakeLocked()
+}
+
+// HoseEstimateStat is the capacity estimate, observed.
+type HoseEstimateStat struct {
+	Estimate, LastSample float64 // bytes per second
+	Ticks, Valid         int64   // ticks, and those with the transport as the bottleneck
+	Probes, Measured     int64   // ticks spent probing, and set from a measured estimate
+	FwdSeen, FwdQueued   int64   // the forward source's frames read, and those in backlogged runs
+}
+
+// HoseEstimateStats reads the node's capacity estimate; ok is false when none runs.
+func (p *PubSub) HoseEstimateStats() (HoseEstimateStat, bool) {
+	if p.hose == nil || p.hose.est == nil {
+		return HoseEstimateStat{}, false
+	}
+	e := p.hose.est
+	return HoseEstimateStat{
+		Estimate: math.Float64frombits(e.est.Load()), LastSample: math.Float64frombits(e.last.Load()),
+		Ticks: e.ticks.Load(), Valid: e.valid.Load(), Probes: e.probes.Load(), Measured: e.measured.Load(),
+		FwdSeen: e.fwdSeen.Load(), FwdQueued: e.fwdQueued.Load(),
+	}, true
+}
+
+// newHoseEstimator fills the estimate's defaults.
+func newHoseEstimator(cfg HoseEstimate) (*hoseEstimator, error) {
+	if cfg.MeanRTT == nil || cfg.FrameBytes <= 0 || cfg.Prior <= 0 {
+		return nil, errHoseEstimate
+	}
+	if cfg.Tick <= 0 {
+		cfg.Tick = 100 * time.Millisecond
+	}
+	if cfg.Horizon <= 0 {
+		cfg.Horizon = 30 * time.Second
+	}
+	if cfg.ProbeGain <= 1 {
+		cfg.ProbeGain = 1.25
+	}
+	if cfg.ForwardQueue <= 0 {
+		cfg.ForwardQueue = 10 * time.Millisecond
+	}
+	e := &hoseEstimator{cfg: cfg}
+	e.est.Store(math.Float64bits(cfg.Prior))
+	return e, nil
+}
diff -ruN -x BUILD.bazel -x sign.go -x '*.orig' base/hoseestimate_test.go fork/hoseestimate_test.go
--- base/hoseestimate_test.go	1970-01-01 01:00:00.000000000 +0100
+++ fork/hoseestimate_test.go	2026-10-22 13:36:32.091491981 +0200
@@ -0,0 +1,131 @@
+package pubsub
+
+import (
+	"math"
+	"testing"
+	"time"
+)
+
+func TestHoseEstimate(t *testing.T) {
+	newH := func(prior float64) *hoseWindow {
+		cfg := HoseConfig{Target: 20 * time.Millisecond, Kp: 0.1, Init: 2, Min: 1, Max: 10000, Timeout: time.Second}
+		e, err := newHoseEstimator(HoseEstimate{
+			Delivered: func() uint64 { return 0 }, MeanRTT: func() time.Duration { return 80 * time.Millisecond },
+			FrameBytes: 1000, Prior: prior,
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return &hoseWindow{cfg: cfg, w: cfg.Init, est: e}
+	}
+	now := time.Now()
+	t.Run("the window is the measured maximum times round trip plus target", func(t *testing.T) {
+		h := newH(1e5)
+		h.est.samples = []rateSample{{now, 4e5}, {now, 6e5}, {now, 5e5}}
+		h.applyEstimate(now, nil)
+		if want := 6e5 * 0.1 / 1000; math.Abs(h.w-want) > 1e-9 {
+			t.Fatalf("w %.2f, want %.2f from the maximum sample", h.w, want)
+		}
+	})
+	t.Run("an unmeasured window that binds probes up, one that does not holds the prior", func(t *testing.T) {
+		h := newH(1e5)
+		h.applyEstimate(now, nil)
+		if want := 1e5 * 0.1 / 1000; math.Abs(h.w-want) > 1e-9 {
+			t.Fatalf("w %.2f, want the prior's %.2f", h.w, want)
+		}
+		for range 2 { // a backlog waits at the window each tick; growing it wakes the waiter
+			h.waiters, h.waitCls = []chan struct{}{make(chan struct{})}, []int{0}
+			h.applyEstimate(now, nil)
+		}
+		if want := 1e5 * 1.25 * 1.25 * 0.1 / 1000; math.Abs(h.w-want) > 1e-9 {
+			t.Fatalf("w %.3f after two binding ticks, want %.3f", h.w, want)
+		}
+	})
+	t.Run("samples past the horizon expire and the estimate is kept", func(t *testing.T) {
+		h := newH(1e5)
+		h.est.samples = []rateSample{{now, 6e5}}
+		h.applyEstimate(now, nil)
+		h.applyEstimate(now.Add(31*time.Second), nil)
+		if len(h.est.samples) != 0 || math.Abs(h.w-60) > 1e-9 {
+			t.Fatalf("%d samples, w %.2f; want none and the kept 60", len(h.est.samples), h.w)
+		}
+	})
+	t.Run("from acknowledgements, an unqueued rate only raises, a queued one measures", func(t *testing.T) {
+		h := newH(1e5) // prior 1e5 B/s; frames of 1000 B over three 100 ms ticks
+		h.est.cfg.Delivered = nil
+		tick := func(acks int, q time.Duration) {
+			h.est.recent[h.est.n%3] = acks
+			h.est.n++
+			h.applyAcked(now, []time.Duration{q})
+		}
+		for range 3 {
+			tick(10, 5*time.Millisecond) // 1e5 B/s, no queue: a lower bound equal to the prior
+		}
+		if want := 1e5 * 0.1 / 1000; math.Abs(h.w-want) > 1e-9 {
+			t.Fatalf("w %.2f after unqueued ticks at the prior's rate, want %.2f", h.w, want)
+		}
+		for range 3 {
+			tick(4, 5*time.Millisecond) // lower and unqueued: must not lower the estimate
+		}
+		if want := 1e5 * 0.1 / 1000; math.Abs(h.w-want) > 1e-9 {
+			t.Fatalf("w %.2f after low unqueued ticks, want the kept %.2f", h.w, want)
+		}
+		tick(4, 40*time.Millisecond) // queued: a measurement of 4e4 B/s
+		if want := 4e4 * 0.1 / 1000; math.Abs(h.w-want) > 1e-9 {
+			t.Fatalf("w %.2f after a queued tick, want the measured %.2f", h.w, want)
+		}
+		h.waiters, h.waitCls = []chan struct{}{make(chan struct{})}, []int{0}
+		tick(4, 5*time.Millisecond) // binding with room: probe
+		if want := 4e4 * 1.25 * 0.1 / 1000; math.Abs(h.w-want) > 1e-9 {
+			t.Fatalf("w %.3f after a binding unqueued tick, want the probe's %.3f", h.w, want)
+		}
+	})
+	t.Run("locally, a limited round probes while the rate follows and measures at its plateau", func(t *testing.T) {
+		h := newH(1e5)
+		h.est.cfg.Delivered, h.est.cfg.LocalSaturation = nil, true
+		round := func(acks int, limited bool) {
+			for range 3 {
+				if limited {
+					h.waiters, h.waitCls = []chan struct{}{make(chan struct{})}, []int{0}
+				}
+				h.est.recent[h.est.n%3] = acks
+				h.est.n++
+				h.applyLocal(now)
+			}
+		}
+		round(10, true) // 1e5 B/s, the window the limit: a probe
+		if want := 1e5 * 1.25 * 0.1 / 1000; math.Abs(h.w-want) > 1e-9 {
+			t.Fatalf("w %.3f after the first limited round, want the probe's %.3f", h.w, want)
+		}
+		round(12, true) // +20 percent: it follows, probe again
+		if want := 1.2e5 * 1.25 * 0.1 / 1000; h.w < 1.25e5*1.25*0.1/1000-1e-9 {
+			t.Fatalf("w %.3f after a following round, want a second probe (>= %.3f)", h.w, want)
+		}
+		round(12, true) // flat: the plateau, a measurement of 1.2e5
+		if want := 1.2e5 * 0.1 / 1000; math.Abs(h.w-want) > 1e-9 {
+			t.Fatalf("w %.3f at the plateau, want the measured %.3f", h.w, want)
+		}
+		h.waiters, h.waitCls = nil, nil
+		round(6, false) // not limited, lower: a lower bound does not lower it
+		if want := 1.2e5 * 0.1 / 1000; math.Abs(h.w-want) > 1e-9 {
+			t.Fatalf("w %.3f after an unlimited low round, want the kept %.3f", h.w, want)
+		}
+	})
+	t.Run("an acknowledgement under an estimate counts toward the tick", func(t *testing.T) {
+		h := newH(1e5)
+		h.inflight = 1
+		h.release(30*time.Millisecond, true, false)
+		if h.tickAcks != 1 || len(h.tickQ) != 1 {
+			t.Fatalf("tick acks %d samples %d, want 1 and 1", h.tickAcks, len(h.tickQ))
+		}
+	})
+	t.Run("acknowledgements no longer step an estimated window", func(t *testing.T) {
+		h := newH(1e5)
+		h.w = 50
+		h.inflight = 1
+		h.release(500*time.Millisecond, true, false)
+		if h.w != 50 || h.acks != 1 {
+			t.Fatalf("w %.2f acks %d, want 50 and 1", h.w, h.acks)
+		}
+	})
+}
diff -ruN -x BUILD.bazel -x sign.go -x '*.orig' base/hosefwd.go fork/hosefwd.go
--- base/hosefwd.go	1970-01-01 01:00:00.000000000 +0100
+++ fork/hosefwd.go	2026-10-22 13:36:32.091491981 +0200
@@ -0,0 +1,277 @@
+package pubsub
+
+import (
+	"encoding/binary"
+	"fmt"
+	"math"
+	"sort"
+	"time"
+)
+
+// --- The capacity estimate from forward delay ---
+//
+// Q133's acknowledged sources failed because an acknowledgement's timing carries the receiver's
+// uplink queue on the way back. Here the receiver stamps its receive time into the hose
+// acknowledgement, so the sender reads the one-way delay of each frame: receive stamp − pop time.
+// Per peer, the minimum of it is propagation plus the clock offset (LEDBAT's base delay, RFC
+// 6817), so the excess is the forward queue alone, whatever the clocks. Queueing at the sender's
+// uplink shows in every peer at once; at one receiver's downlink, in that peer only.
+//
+// Each frame then has an exit time on the sender's clock, stamp − the peer's base delay: the
+// moment it left the sender's queue, give or take the receiver's. The stamp names the indices it
+// times -- the frames of the RPC just received -- since the HAVE beside it covers every frame the
+// peer holds, including ours still in flight that it got from others first (the first form timed
+// those too, at one exit, and read the publisher at 4.4 × its uplink).
+//
+// The rate is FIFO arithmetic. Each frame also carries the node's written-bytes count at its pop;
+// in a backlog, what was written between two frames' pops leaves between their exits, frames to
+// every peer, unacknowledged ones and control alike. Over a run of frames whose forward queue stays
+// above the threshold, the slope of written bytes against exit time is the uplink's rate -- no
+// plateau, and no count of acknowledged frames, which under-read (Q133 smoke 2, again in the first
+// form). Outside such runs a binding window with no queue showing is probed up.
+
+const hoseStampMagic = "HTS\x02"
+
+// encodeHoseStamp is the receive stamp's pseudo id: the time, a group root and the indices of
+// that group it times, carried beside the acknowledging HAVE.
+func encodeHoseStamp(at time.Time, root string, idxs []uint32) string {
+	b := make([]byte, 0, len(hoseStampMagic)+8+len(root)+2*len(idxs))
+	b = append(b, hoseStampMagic...)
+	b = binary.BigEndian.AppendUint64(b, uint64(at.UnixNano()))
+	b = append(b, root...)
+	for _, i := range idxs {
+		b = binary.BigEndian.AppendUint16(b, uint16(i))
+	}
+	return string(b)
+}
+
+// decodeHoseStamp reads a receive stamp, or reports that mid is not one.
+func decodeHoseStamp(mid string) (at time.Time, root string, idxs []uint32, ok bool) {
+	h := len(hoseStampMagic) + 8 + haveRootLen
+	if len(mid) < h || (len(mid)-h)%2 != 0 || mid[:len(hoseStampMagic)] != hoseStampMagic {
+		return time.Time{}, "", nil, false
+	}
+	at = time.Unix(0, int64(binary.BigEndian.Uint64([]byte(mid[len(hoseStampMagic):]))))
+	root = mid[len(hoseStampMagic)+8 : h]
+	for i := h; i < len(mid); i += 2 {
+		idxs = append(idxs, uint32(binary.BigEndian.Uint16([]byte(mid[i:i+2]))))
+	}
+	return at, root, idxs, true
+}
+
+// WithHoseAckStamp adds the receive stamp to every hose acknowledgement this node sends.
+func WithHoseAckStamp() Option {
+	return func(ps *PubSub) error {
+		gs, ok := ps.rt.(*GossipSubRouter)
+		if !ok {
+			return fmt.Errorf("hose ack stamps require a gossipsub router")
+		}
+		gs.hoseStamp = true
+		return nil
+	}
+}
+
+// hoseAckIDs is an acknowledgement's ids: the HAVEs, and with stamps one receive stamp per
+// group root naming the indices of mids, the frames just received.
+func (gs *GossipSubRouter) hoseAckIDs(mids []string) []string {
+	ids := gs.haveIDontWantIDs(mids)
+	if !gs.hoseStamp || gs.have == nil {
+		return ids
+	}
+	now := time.Now()
+	byRoot := make(map[string][]uint32)
+	var roots []string
+	for _, mid := range mids {
+		root, idx, ok := gs.have.index(mid)
+		if !ok || len(root) != haveRootLen {
+			continue
+		}
+		if byRoot[root] == nil {
+			roots = append(roots, root)
+		}
+		byRoot[root] = append(byRoot[root], idx)
+	}
+	if len(roots) == 0 {
+		return ids
+	}
+	ids = append([]string(nil), ids...)
+	for _, root := range roots {
+		ids = append(ids, encodeHoseStamp(now, root, byRoot[root]))
+	}
+	return ids
+}
+
+// hoseStampOf finds the receive stamps among an IDONTWANT's ids: the time, and the indices they
+// time by root.
+func hoseStampOf(ids []string) (time.Time, map[string]map[uint32]bool, bool) {
+	var at time.Time
+	var out map[string]map[uint32]bool
+	for _, id := range ids {
+		t, root, idxs, ok := decodeHoseStamp(id)
+		if !ok {
+			continue
+		}
+		if out == nil {
+			out = make(map[string]map[uint32]bool)
+		}
+		set := out[root]
+		if set == nil {
+			set = make(map[uint32]bool)
+			out[root] = set
+		}
+		for _, i := range idxs {
+			set[i] = true
+		}
+		at = t
+	}
+	return at, out, out != nil
+}
+
+// fwdSample is one stamped frame: its exit time on our clock, its forward queue, and the node's
+// written bytes at its pop.
+type fwdSample struct {
+	exit  time.Time
+	q     time.Duration
+	wrote int64
+	bound bool
+}
+
+// hoseFwdMinRun is the fewest frames a backlogged run needs before its span reads as a rate.
+const hoseFwdMinRun = 16
+
+// hoseFwdLag is how long after its exit a frame's acknowledgement is waited for before its run is
+// read; later ones are dropped from the rate, which only lowers it.
+const hoseFwdLag = 500 * time.Millisecond
+
+// noteForward records a stamped acknowledgement of a frame popped at popped. minOWD is the peer's
+// running minimum one-way delay, updated here. Caller holds the queue lock.
+func (h *hoseWindow) noteForward(minOWD *time.Duration, have *bool, popped, stamp time.Time, wrote int64, bound bool) {
+	if h.est == nil || !h.est.cfg.Forward {
+		return
+	}
+	owd := stamp.Sub(popped)
+	if !*have || owd < *minOWD {
+		*minOWD, *have = owd, true
+	}
+	q := owd - *minOWD
+	h.mu.Lock()
+	h.fwd = append(h.fwd, fwdSample{exit: popped.Add(q), q: q, wrote: wrote, bound: bound})
+	h.mu.Unlock()
+}
+
+// applyForward is the forward source's step: read the runs whose acknowledgements are in, add a
+// sample for each long enough, then set the window from the maximum inside the horizon, or probe
+// while it binds with no queue showing.
+func (h *hoseWindow) applyForward(now time.Time) {
+	e := h.est
+	h.mu.Lock()
+	queuedNow := false // the latest acknowledgements, not the lagged runs, say whether the link is full now
+	for _, s := range h.fwd {
+		queuedNow = queuedNow || s.q >= e.cfg.ForwardQueue
+	}
+	e.fwdPending = append(e.fwdPending, h.fwd...)
+	h.fwd = h.fwd[:0]
+	binds := len(h.waiters) > 0
+	h.mu.Unlock()
+	sort.Slice(e.fwdPending, func(i, j int) bool { return e.fwdPending[i].exit.Before(e.fwdPending[j].exit) })
+	thr := e.cfg.ForwardQueue
+	cut := 0
+	for cut < len(e.fwdPending) && now.Sub(e.fwdPending[cut].exit) >= hoseFwdLag {
+		cut++
+	}
+	ready := e.fwdPending[:cut]
+	queued, unbound := 0, false
+	for i := 0; i < len(ready); {
+		if ready[i].q < thr {
+			i++
+			continue
+		}
+		j := i
+		for j < len(ready) && ready[j].q >= thr {
+			j++
+		}
+		queued += j - i
+		if r, ok := runRate(ready[i:j]); ok {
+			bound := 0
+			for _, s := range ready[i:j] {
+				if s.bound {
+					bound++
+				}
+			}
+			if 2*bound > j-i {
+				// Sent under a binding window: the window, perhaps not the link, set the pace, so
+				// the rate is only a floor.
+				e.floors = append(e.floors, rateSample{now, r})
+			} else {
+				e.add(now, r)
+				unbound = true
+			}
+		}
+		i = j
+	}
+	e.fwdQueued.Add(int64(queued))
+	e.fwdSeen.Add(int64(len(ready)))
+	e.fwdPending = append(e.fwdPending[:0], e.fwdPending[cut:]...)
+	cut = 0
+	for cut < len(e.samples) && now.Sub(e.samples[cut].at) > e.cfg.Horizon {
+		cut++
+	}
+	e.samples = e.samples[cut:]
+	cut = 0
+	for cut < len(e.floors) && now.Sub(e.floors[cut].at) > e.cfg.Horizon {
+		cut++
+	}
+	e.floors = e.floors[cut:]
+	prev := math.Float64frombits(e.est.Load())
+	rate := prev
+	measured := 0.0
+	for _, s := range e.samples {
+		measured = math.Max(measured, s.rate)
+	}
+	if measured > 0 {
+		rate = measured
+		e.measured.Add(1)
+	}
+	// A probe is a floor until the link is seen full with the window out of the way; a rate
+	// measured under a binding window is a floor too, never a cap.
+	if unbound {
+		e.probe = 0
+	}
+	for _, s := range e.floors {
+		rate = math.Max(rate, s.rate)
+	}
+	rate = math.Max(rate, e.probe)
+	if binds && !queuedNow {
+		e.probe = math.Max(rate, prev) * e.cfg.ProbeGain
+		rate = e.probe
+		e.probes.Add(1)
+	}
+	e.est.Store(math.Float64bits(rate))
+	h.setWindow(rate * (e.cfg.MeanRTT() + h.cfg.Target).Seconds() / float64(e.cfg.FrameBytes))
+}
+
+// runRate is a backlogged run's rate: the least-squares slope of written bytes against exit
+// time, so no one frame's exit, off by its peer's base, decides it.
+func runRate(run []fwdSample) (float64, bool) {
+	if len(run) < hoseFwdMinRun {
+		return 0, false
+	}
+	t0 := run[0].exit
+	var sx, sy float64
+	for _, s := range run {
+		sx += s.exit.Sub(t0).Seconds()
+		sy += float64(s.wrote)
+	}
+	n := float64(len(run))
+	mx, my := sx/n, sy/n
+	var sxx, sxy float64
+	for _, s := range run {
+		dx := s.exit.Sub(t0).Seconds() - mx
+		sxx += dx * dx
+		sxy += dx * (float64(s.wrote) - my)
+	}
+	if sxx <= 0 || sxy <= 0 {
+		return 0, false
+	}
+	return sxy / sxx, true
+}
diff -ruN -x BUILD.bazel -x sign.go -x '*.orig' base/hosefwd_test.go fork/hosefwd_test.go
--- base/hosefwd_test.go	1970-01-01 01:00:00.000000000 +0100
+++ fork/hosefwd_test.go	2026-10-22 13:36:32.091491981 +0200
@@ -0,0 +1,95 @@
+package pubsub
+
+import (
+	"math"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestHoseForwardEstimate(t *testing.T) {
+	const frame = 8192
+	const capBps = 50e6 / 8 // the uplink, bytes per second
+	newH := func(prior float64) *hoseWindow {
+		cfg := HoseConfig{Target: 20 * time.Millisecond, Kp: 0.1, Init: 2, Min: 1, Max: 100000, Timeout: time.Second}
+		e, err := newHoseEstimator(HoseEstimate{
+			MeanRTT: func() time.Duration { return 112 * time.Millisecond }, FrameBytes: frame, Prior: prior, Forward: true,
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return &hoseWindow{cfg: cfg, w: cfg.Init, est: e}
+	}
+	type peerLink struct {
+		minOWD  time.Duration
+		haveOWD bool
+		offset  time.Duration // the peer's clock ahead of ours plus propagation
+	}
+	// burst sends n frames at t0 into a queue draining at capBps, round-robin over peers, and
+	// acknowledges each with the peer's stamp; the first frame of each peer sees an empty queue.
+	burst := func(h *hoseWindow, peers []*peerLink, t0 time.Time, n int) {
+		per := time.Duration(float64(frame) / capBps * float64(time.Second))
+		for i := range n {
+			p := peers[i%len(peers)]
+			exit := t0.Add(time.Duration(i+1) * per) // popped at t0, left the uplink here
+			h.noteForward(&p.minOWD, &p.haveOWD, t0, exit.Add(p.offset), int64(i*frame), false)
+		}
+	}
+	t0 := time.Unix(1000, 0)
+	t.Run("stamps round-trip and are found among an acknowledgement's ids", func(t *testing.T) {
+		at, root := time.Unix(0, 1234567890123), strings.Repeat("r", haveRootLen)
+		got, idx, ok := hoseStampOf([]string{"HAVE-ish", encodeHoseStamp(at, root, []uint32{3, 250})})
+		if !ok || !got.Equal(at) || len(idx[root]) != 2 || !idx[root][3] || !idx[root][250] {
+			t.Fatalf("got %v %v %v", got, idx, ok)
+		}
+		if _, _, _, ok := decodeHoseStamp("HTS\x01" + strings.Repeat("x", 8+haveRootLen)); ok {
+			t.Fatal("a wrong magic decoded")
+		}
+	})
+	t.Run("a backlogged burst reads the uplink whatever the clocks and paths", func(t *testing.T) {
+		h := newH(capBps * 0.3)
+		peers := []*peerLink{{offset: 3 * time.Second}, {offset: -40 * time.Millisecond}, {offset: 70 * time.Millisecond}, {offset: 5 * time.Millisecond}}
+		// a first, short exchange teaches each peer its base: an idle frame each
+		for i, p := range peers {
+			pop := t0.Add(time.Duration(i) * time.Millisecond)
+			h.noteForward(&p.minOWD, &p.haveOWD, pop, pop.Add(p.offset), 0, false)
+		}
+		burst(h, peers, t0.Add(time.Second), 200)
+		h.applyForward(t0.Add(3 * time.Second))
+		est := math.Float64frombits(h.est.est.Load())
+		if r := est / capBps; r < 0.97 || r > 1.03 {
+			t.Fatalf("estimate %.3f × the uplink, want 1 (valid samples %d)", r, h.est.valid.Load())
+		}
+		if want := capBps * 0.132 / frame; math.Abs(h.w-want) > 1 {
+			t.Fatalf("window %.1f, want %.1f", h.w, want)
+		}
+	})
+	t.Run("frames with no queue measure nothing and a binding window probes up", func(t *testing.T) {
+		h := newH(capBps * 0.3)
+		p := &peerLink{offset: 30 * time.Millisecond}
+		for i := range 50 {
+			pop := t0.Add(time.Duration(i) * 10 * time.Millisecond)
+			h.noteForward(&p.minOWD, &p.haveOWD, pop, pop.Add(p.offset), int64(i*frame), false)
+		}
+		h.waiters, h.waitCls = []chan struct{}{make(chan struct{})}, []int{0}
+		h.applyForward(t0.Add(2 * time.Second))
+		if h.est.valid.Load() != 0 {
+			t.Fatalf("%d samples from an idle link", h.est.valid.Load())
+		}
+		if est := math.Float64frombits(h.est.est.Load()); math.Abs(est/(capBps*0.3*1.25)-1) > 1e-9 {
+			t.Fatalf("estimate %.0f, want the prior probed once", est)
+		}
+	})
+	t.Run("a run too short or too recent is not read", func(t *testing.T) {
+		h := newH(capBps)
+		p := &peerLink{offset: time.Millisecond}
+		h.noteForward(&p.minOWD, &p.haveOWD, t0, t0.Add(p.offset), 0, false)
+		burst(h, []*peerLink{p}, t0.Add(time.Second), hoseFwdMinRun-1)
+		h.applyForward(t0.Add(2 * time.Second))
+		burst(h, []*peerLink{p}, t0.Add(3*time.Second), 100)
+		h.applyForward(t0.Add(3*time.Second + 100*time.Millisecond)) // inside the lag
+		if h.est.valid.Load() != 0 || len(h.est.fwdPending) == 0 {
+			t.Fatalf("valid %d pending %d; want none read and the recent run kept", h.est.valid.Load(), len(h.est.fwdPending))
+		}
+	})
+}
diff -ruN -x BUILD.bazel -x sign.go -x '*.orig' base/hose.go fork/hose.go
--- base/hose.go	1970-01-01 01:00:00.000000000 +0100
+++ fork/hose.go	2026-10-22 13:36:32.091069297 +0200
@@ -0,0 +1,536 @@
+package pubsub
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"sort"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	pb "github.com/libp2p/go-libp2p-pubsub/pb"
+	"github.com/libp2p/go-libp2p/core/peer"
+)
+
+// --- Hose rate control: a node-wide window over frames in flight ---
+//
+// A node's uplink is one hose shared by every peer it feeds, and the transport divides it by fair
+// share: a node that commits a frame to many peers at once serves each of them slowly and all of
+// them late. Hose Rate Control (Birke, Kiraly et al., P2P 2011; Computer Networks 2014) bounds the
+// frames a node has in flight -- popped to a peer and not yet acknowledged -- by a window W driven
+// by the queueing delay those frames see: on every acknowledgement W ← W − Kp·(D̂ − D0), where
+// D̂ = ack time − pop time − the peer's base round trip, and D0 is the target. A fast uplink keeps
+// D̂ under D0 and W grows; a slow or saturated one pushes D̂ over it and W shrinks, with no
+// configured rate and no class label. Pushes and pull answers take the same window.
+//
+// The acknowledgement is the peer's HAVE bitmap covering the frame. Gossipsub never tells the
+// sender of a message that it arrived, so WithHoseAck makes a receiver send its bitmap to the
+// pusher as well as to its mesh. A timeout releases a frame whose acknowledgement never comes.
+// Requires WithHaveBitmaps and WithHaveDispatch, whose per-peer state maps frames to indices.
+
+// HoseConfig parameterises the window. Passive records the delay samples and the window it would
+// have set without ever holding a pop back.
+type HoseConfig struct {
+	Target  time.Duration
+	Kp      float64 // window frames per millisecond of delay error
+	Init    float64
+	Min     float64
+	Max     float64
+	Timeout time.Duration
+	Passive bool
+	// FrameSlots queues a batched answer one frame per RPC, so it takes a slot per frame rather
+	// than one slot for the batch (Q132: at W = 2 a publisher had 1114 frames in flight).
+	FrameSlots bool
+	// Estimate, when set, sets the window from a capacity estimate instead of stepping it on each
+	// acknowledgement (hoseestimate.go); the acknowledgements are still sampled and reported.
+	Estimate *HoseEstimate
+	// BaseRTT is the peer's base round trip (the transport's minimum RTT); zero or nil falls back
+	// on the smallest pop-to-ack time seen from that peer.
+	BaseRTT func(peer.ID) time.Duration
+	// PeerCap, when positive, bounds the frames in flight to any one peer. The node's window
+	// bounds its own uplink; this bounds what it commits to one receiver's downlink, which a
+	// fast sender fills long before its own window binds (Q144).
+	PeerCap int
+}
+
+type hoseWindow struct {
+	cfg HoseConfig
+	est *hoseEstimator // the capacity estimate, when cfg.Estimate is set
+	// tickAcks and tickQ are the frames acknowledged and their queueing delays since the
+	// estimate's last tick, under mu.
+	tickAcks int
+	tickQ    []time.Duration
+	fwd      []fwdSample  // stamped acknowledgements since the forward source's last tick, under mu
+	written  atomic.Int64 // bytes this node has handed its streams, every peer and lane
+
+	mu       sync.Mutex
+	w        float64
+	inflight int
+	waiters  []chan struct{}
+	// waitCls is each waiter's priority class (WithFrameClassGrants), aligned with waiters; a
+	// freed slot goes to the lowest class, first come within it. All zero: plain FIFO.
+	waitCls []int
+
+	// Observation, under mu.
+	wLo, wHi         float64
+	samples          []time.Duration // queueing-delay samples, capped
+	ansSamples       []time.Duration // the same for pull answers alone
+	acks, timeouts   int64
+	lateAcks         int64 // acknowledgements after the frame's timeout, sampled without a slot
+	waitTime         time.Duration
+	acquires, gateOn int64
+	peakInflight     int
+
+	// onFree, when set, is told that a slot is free after every waiting pop was served: the
+	// offer pump's kick (hoseoffer.go). Called under mu; it must only start work elsewhere.
+	onFree func()
+}
+
+const hoseSampleCap = 8192
+
+var errHoseEstimate = fmt.Errorf("hose estimate needs MeanRTT, a frame size and a prior")
+
+// WithHoseWindow installs the node-wide hose window. Every peer queue shares it.
+func WithHoseWindow(cfg HoseConfig) Option {
+	return func(ps *PubSub) error {
+		if cfg.Min < 1 || cfg.Max < cfg.Min || cfg.Init < cfg.Min || cfg.Init > cfg.Max {
+			return fmt.Errorf("hose window needs 1 <= min <= init <= max")
+		}
+		if cfg.Timeout <= 0 || cfg.Kp <= 0 {
+			return fmt.Errorf("hose window needs a positive timeout and gain")
+		}
+		ps.hose = &hoseWindow{cfg: cfg, w: cfg.Init, wLo: cfg.Init, wHi: cfg.Init}
+		if cfg.Estimate != nil {
+			e, err := newHoseEstimator(*cfg.Estimate)
+			if err != nil {
+				return err
+			}
+			ps.hose.est = e
+		}
+		return nil
+	}
+}
+
+// WithHoseAck makes a receiver send its HAVE bitmap for a received group to the peer that sent
+// the frame, not only to its other mesh peers: the acknowledgement the hose window clocks on.
+func WithHoseAck() Option {
+	return func(ps *PubSub) error {
+		gs, ok := ps.rt.(*GossipSubRouter)
+		if !ok {
+			return fmt.Errorf("hose ack requires a gossipsub router")
+		}
+		gs.hoseAck = true
+		return nil
+	}
+}
+
+// hoseAckDuplicate acknowledges a frame that arrived as a duplicate, which never reaches
+// Preprocess: without it the sender's slot waits out the full timeout and yields no sample, so
+// every answer overtaken by another copy read as a loss (Q131, the collapse at σ = 0.7).
+func (gs *GossipSubRouter) hoseAckDuplicate(mid string, from peer.ID) {
+	if !gs.hoseAck || gs.have == nil || from == gs.p.host.ID() || !gs.feature(GossipSubFeatureIdontwant, gs.peers[from]) {
+		return
+	}
+	ids := append(gs.hoseAckIDs([]string{mid}), gs.haveOriginSentAck(from, mid)...)
+	if len(ids) == 0 {
+		return // our own frame under OriginHaveNone: no HAVE, so no acknowledgement
+	}
+	ack := rpcWithControl(nil, nil, nil, nil, nil, []*pb.ControlIDontWant{{MessageIDs: ids}})
+	gs.sendRPC(from, ack, true)
+}
+
+// limit is the window as a frame count.
+func (h *hoseWindow) limit() int {
+	return int(math.Max(1, math.Floor(h.w)))
+}
+
+// acquire blocks until a frame may be popped, an urgent RPC reaches the caller's queue, or ctx
+// ends; granted is false when it returned for an urgent arrival.
+func (h *hoseWindow) acquire(ctx context.Context, urgent <-chan struct{}) (granted bool, err error) {
+	return h.acquireClass(ctx, urgent, 0)
+}
+
+// acquireClass is acquire for a writer whose best queued frame has priority class cls.
+func (h *hoseWindow) acquireClass(ctx context.Context, urgent <-chan struct{}, cls int) (granted bool, err error) {
+	h.mu.Lock()
+	if h.cfg.Passive || (h.inflight < h.limit() && len(h.waiters) == 0) {
+		h.takeLocked()
+		h.mu.Unlock()
+		return true, nil
+	}
+	ch := make(chan struct{})
+	h.waiters = append(h.waiters, ch)
+	h.waitCls = append(h.waitCls, cls)
+	h.gateOn++
+	h.mu.Unlock()
+	t0 := time.Now()
+	select {
+	case <-ch:
+		h.mu.Lock()
+		h.waitTime += time.Since(t0)
+		h.mu.Unlock()
+		return true, nil
+	case <-urgent:
+		h.withdraw(ch)
+		return false, nil
+	case <-ctx.Done():
+		h.withdraw(ch)
+		return false, ctx.Err()
+	}
+}
+
+func (h *hoseWindow) takeLocked() {
+	h.inflight++
+	h.acquires++
+	if h.inflight > h.peakInflight {
+		h.peakInflight = h.inflight
+	}
+}
+
+// withdraw takes a waiter out of the line; a slot granted to it meanwhile is given back.
+func (h *hoseWindow) withdraw(ch chan struct{}) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	for i, w := range h.waiters {
+		if w == ch {
+			h.waiters = append(h.waiters[:i], h.waiters[i+1:]...)
+			h.waitCls = append(h.waitCls[:i], h.waitCls[i+1:]...)
+			return
+		}
+	}
+	h.inflight--
+	h.wakeLocked()
+}
+
+// add counts n more frames in flight past the one a pop took (a multi-frame RPC overshoots).
+func (h *hoseWindow) add(n int) {
+	if n <= 0 {
+		return
+	}
+	h.mu.Lock()
+	h.inflight += n
+	if h.inflight > h.peakInflight {
+		h.peakInflight = h.inflight
+	}
+	h.mu.Unlock()
+}
+
+// release returns one frame's slot; with a sample, the controller steps on its queueing delay.
+func (h *hoseWindow) release(qd time.Duration, sampled, answer bool) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.inflight--
+	if sampled {
+		h.acks++
+		h.stepLocked(qd, answer)
+	} else {
+		h.timeouts++
+	}
+	h.wakeLocked()
+}
+
+// lateSample steps the controller on an acknowledgement that came after the frame's timeout had
+// already returned its slot. Dropping it, as the first form did, censored exactly the slow
+// frames: the controller saw only the fast ones and opened while the queue it built went unseen.
+func (h *hoseWindow) lateSample(qd time.Duration, answer bool) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.lateAcks++
+	h.stepLocked(qd, answer)
+	h.wakeLocked()
+}
+
+func (h *hoseWindow) stepLocked(qd time.Duration, answer bool) {
+	if len(h.samples) < hoseSampleCap {
+		h.samples = append(h.samples, qd)
+	}
+	if answer && len(h.ansSamples) < hoseSampleCap {
+		h.ansSamples = append(h.ansSamples, qd)
+	}
+	if h.est != nil {
+		// The estimate sets the window; an acknowledgement is a delivered frame and a queueing sample.
+		h.tickAcks++
+		h.tickQ = append(h.tickQ, qd)
+		return
+	}
+	errMs := float64(qd-h.cfg.Target) / float64(time.Millisecond)
+	h.w = math.Min(h.cfg.Max, math.Max(h.cfg.Min, h.w-h.cfg.Kp*errMs))
+	h.wLo, h.wHi = math.Min(h.wLo, h.w), math.Max(h.wHi, h.w)
+}
+
+// unused returns a slot taken for a pop that sent no frame.
+func (h *hoseWindow) unused() {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.inflight--
+	h.acquires--
+	h.wakeLocked()
+}
+
+func (h *hoseWindow) wakeLocked() {
+	for len(h.waiters) > 0 && (h.cfg.Passive || h.inflight < h.limit()) {
+		best := 0
+		for i := 1; i < len(h.waitCls); i++ {
+			if h.waitCls[i] < h.waitCls[best] {
+				best = i
+			}
+		}
+		ch := h.waiters[best]
+		h.waiters = append(h.waiters[:best], h.waiters[best+1:]...)
+		h.waitCls = append(h.waitCls[:best], h.waitCls[best+1:]...)
+		h.takeLocked()
+		close(ch)
+	}
+	if h.onFree != nil && len(h.waiters) == 0 && (h.cfg.Passive || h.inflight < h.limit()) {
+		h.onFree()
+	}
+}
+
+// free is the data slots open now: none while a pop waits; unbounded when passive.
+func (h *hoseWindow) free() float64 {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.cfg.Passive {
+		return math.Inf(1)
+	}
+	if len(h.waiters) > 0 {
+		return 0
+	}
+	return float64(h.limit() - h.inflight)
+}
+
+// ResetHoseStats starts a new observation window: samples, counters and the window's range.
+// The window itself and the frames in flight are kept, so the controller does not notice.
+func (p *PubSub) ResetHoseStats() {
+	h := p.hose
+	if h == nil {
+		return
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.samples, h.ansSamples = nil, nil
+	h.acks, h.timeouts, h.lateAcks, h.acquires, h.gateOn, h.waitTime = 0, 0, 0, 0, 0, 0
+	h.wLo, h.wHi, h.peakInflight = h.w, h.w, h.inflight
+}
+
+// HoseStat is one node's hose window, observed.
+type HoseStat struct {
+	W, WLo, WHi         float64
+	Acks, Timeouts      int64
+	LateAcks            int64 // acknowledgements after a timeout, sampled (not in Acks)
+	Acquires, Gated     int64
+	WaitTime            time.Duration
+	PeakInflight        int
+	QueueP50, QueueP90  time.Duration
+	QueueMean, QueueMax time.Duration
+	// Answers is how many of the acks were pull answers, AnswerP50/P90 their queueing.
+	Answers              int
+	AnswerP50, AnswerP90 time.Duration
+}
+
+// HoseStats reads the node's hose window; ok is false when none is installed.
+func (p *PubSub) HoseStats() (HoseStat, bool) {
+	h := p.hose
+	if h == nil {
+		return HoseStat{}, false
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	s := HoseStat{W: h.w, WLo: h.wLo, WHi: h.wHi, Acks: h.acks, Timeouts: h.timeouts, LateAcks: h.lateAcks,
+		Acquires: h.acquires, Gated: h.gateOn, WaitTime: h.waitTime, PeakInflight: h.peakInflight}
+	if n := len(h.samples); n > 0 {
+		sorted := append([]time.Duration(nil), h.samples...)
+		sort.Slice(sorted, func(i, j int) bool { return sorted[i] < sorted[j] })
+		var sum time.Duration
+		for _, d := range sorted {
+			sum += d
+		}
+		s.QueueP50, s.QueueP90, s.QueueMax = sorted[n/2], sorted[n*9/10], sorted[n-1]
+		s.QueueMean = sum / time.Duration(n)
+	}
+	if n := len(h.ansSamples); n > 0 {
+		sorted := append([]time.Duration(nil), h.ansSamples...)
+		sort.Slice(sorted, func(i, j int) bool { return sorted[i] < sorted[j] })
+		s.Answers, s.AnswerP50, s.AnswerP90 = n, sorted[n/2], sorted[n*9/10]
+	}
+	return s, true
+}
+
+// --- The per-peer side, under the queue's mutex ---
+
+// sentFrame is a frame in flight: when it was popped, and whether it answered an ask.
+type sentFrame struct {
+	at      time.Time
+	wrote   int64 // the node's written bytes when it was popped, the forward source's byte clock
+	bound   bool  // pops were waiting on the window when it went: a rate under it is a floor
+	ans     bool
+	expired bool // its timeout returned the slot; a late acknowledgement still samples
+}
+
+// hoseLateHorizon is how long, in timeouts, an expired frame waits for a late acknowledgement.
+const hoseLateHorizon = 10
+
+// hoseSent is one peer's frames in flight: pop time per group root and index.
+type hoseSent struct {
+	at   map[string]map[uint32]sentFrame
+	minD time.Duration // smallest pop-to-ack seen, the fallback base round trip
+	// minOWD is the smallest stamped one-way delay seen, the forward source's base (hosefwd.go).
+	minOWD  time.Duration
+	haveOWD bool
+}
+
+// hasDataLocked reports whether the normal lane holds a data RPC.
+func (q *rpcQueue) hasDataLocked() bool {
+	for _, e := range q.queue.normal {
+		if len(e.rpc.Publish) > 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// hoseAfterPopLocked accounts a normal-lane pop that held a slot: the frames it sends go in
+// flight with their pop time and a timeout; a pop that sends none gives the slot back.
+func (q *rpcQueue) hoseAfterPopLocked(out *RPC) {
+	if !q.hoseHolding {
+		return
+	}
+	q.hoseHolding = false
+	var frames []*pb.Message
+	if out != nil && q.have != nil {
+		for _, m := range out.Publish {
+			if _, _, ok := q.have.index(m); ok {
+				frames = append(frames, m)
+			}
+		}
+	}
+	if len(frames) == 0 {
+		q.hose.unused()
+		return
+	}
+	q.hose.add(len(frames) - 1)
+	if q.hoseSent == nil {
+		q.hoseSent = &hoseSent{at: make(map[string]map[uint32]sentFrame)}
+	}
+	now := time.Now()
+	q.hose.mu.Lock()
+	bound := len(q.hose.waiters) > 0
+	q.hose.mu.Unlock()
+	for _, m := range frames {
+		root, idx, _ := q.have.index(m)
+		byIdx := q.hoseSent.at[root]
+		if byIdx == nil {
+			byIdx = make(map[uint32]sentFrame)
+			q.hoseSent.at[root] = byIdx
+		}
+		if e, dup := byIdx[idx]; dup && !e.expired {
+			// A second copy of one frame to one peer: one acknowledgement will cover both.
+			q.hose.unused()
+			continue
+		}
+		byIdx[idx] = sentFrame{at: now, ans: out.solicited, wrote: q.hose.written.Load(), bound: bound}
+		q.hoseToPeer++
+		time.AfterFunc(q.hose.cfg.Timeout, func() { q.hoseExpire(root, idx, now) })
+	}
+}
+
+// hoseExpire releases a frame whose acknowledgement never came.
+func (q *rpcQueue) hoseExpire(root string, idx uint32, at time.Time) {
+	q.queueMu.Lock()
+	defer q.queueMu.Unlock()
+	if q.hoseSent == nil {
+		return
+	}
+	e, ok := q.hoseSent.at[root][idx]
+	if !ok || !e.at.Equal(at) {
+		return
+	}
+	if e.expired {
+		delete(q.hoseSent.at[root], idx) // no acknowledgement within the late horizon
+		return
+	}
+	e.expired = true
+	q.hoseSent.at[root][idx] = e
+	q.hosePeerReleasedLocked()
+	q.hose.release(0, false, false)
+	time.AfterFunc(time.Duration(hoseLateHorizon-1)*q.hose.cfg.Timeout, func() { q.hoseExpire(root, idx, at) })
+}
+
+// hoseAckedLocked clocks the window on the indices the peer has just announced holding; stamp is
+// the peer's receive time when the acknowledgement carried one, for the indices in stamped only
+// (the bitmap also covers frames the peer got earlier, from others).
+func (q *rpcQueue) hoseAckedLocked(root string, idxs []uint32, stamp time.Time, stamped map[uint32]bool) {
+	if q.hose == nil || q.hoseSent == nil {
+		return
+	}
+	byIdx := q.hoseSent.at[root]
+	if len(byIdx) == 0 {
+		return
+	}
+	now := time.Now()
+	for _, idx := range idxs {
+		e, ok := byIdx[idx]
+		if !ok {
+			continue
+		}
+		delete(byIdx, idx)
+		if !e.expired {
+			q.hosePeerReleasedLocked()
+		}
+		if !stamp.IsZero() && stamped[idx] {
+			q.hose.noteForward(&q.hoseSent.minOWD, &q.hoseSent.haveOWD, e.at, stamp, e.wrote, e.bound)
+		}
+		d := now.Sub(e.at)
+		if q.hoseSent.minD == 0 || d < q.hoseSent.minD {
+			q.hoseSent.minD = d
+		}
+		base := q.hoseSent.minD
+		if q.hose.cfg.BaseRTT != nil {
+			if b := q.hose.cfg.BaseRTT(q.peer); b > 0 {
+				base = b
+			}
+		}
+		qd := d - base
+		if qd < 0 {
+			qd = 0
+		}
+		if e.expired {
+			q.hose.lateSample(qd, e.ans)
+			continue
+		}
+		q.hose.release(qd, true, e.ans)
+	}
+}
+
+// hoseCloseLocked returns every slot the queue's frames still hold.
+func (q *rpcQueue) hoseCloseLocked() {
+	if q.hoseHolding {
+		q.hoseHolding = false
+		q.hose.unused()
+	}
+	if q.hoseSent == nil {
+		return
+	}
+	for root, byIdx := range q.hoseSent.at {
+		for _, e := range byIdx {
+			if !e.expired {
+				q.hose.release(0, false, false)
+			}
+		}
+		delete(q.hoseSent.at, root)
+	}
+	q.hoseToPeer = 0
+}
+
+// hosePeerReleasedLocked counts one of this peer's frames out of flight and wakes a writer waiting
+// on the peer cap. Caller holds the queue lock.
+func (q *rpcQueue) hosePeerReleasedLocked() {
+	if q.hoseToPeer > 0 {
+		q.hoseToPeer--
+	}
+	select {
+	case q.peerFree <- struct{}{}:
+	default:
+	}
+}
diff -ruN -x BUILD.bazel -x sign.go -x '*.orig' base/hoseoffer.go fork/hoseoffer.go
--- base/hoseoffer.go	1970-01-01 01:00:00.000000000 +0100
+++ fork/hoseoffer.go	2026-10-22 13:36:32.091491981 +0200
@@ -0,0 +1,199 @@
+package pubsub
+
+import (
+	"fmt"
+	"math"
+	"sync/atomic"
+	"time"
+
+	pb "github.com/libp2p/go-libp2p-pubsub/pb"
+	"github.com/libp2p/go-libp2p/core/peer"
+)
+
+// --- Offers under the hose window (HRC's offer/select, Birke, Kiraly et al.) ---
+//
+// Phase forwarding announces every frame a node receives to each mesh peer it did not push to,
+// at once, so every frame invites pulls from several directions whatever the node's uplink can
+// serve. In Hose Rate Control the offer is the throttle: a peer offers only while it has a free
+// trading thread. Here a phase announce is an offer that waits in a node-wide FIFO and leaves only
+// while the hose window has room; an offer stays out until the peer asks for the frame (its
+// answer then takes a slot at the writer), the peer says it holds the frame, or a timeout. Data
+// pops waiting for a slot are served first; offers take what is left.
+//
+// Not every offer turns into a frame: each is made to several peers and most are covered by a
+// delivery from elsewhere. Charging an offer a whole slot filled the window with offers and
+// throttled the pulls that carry most of the payload (the first cells). So, as HRC's clipping on
+// the positive-select ratio does, the offers out may reach the free data slots divided by pa, the
+// share of closed offers that were answered.
+
+type offerItem struct {
+	p     peer.ID
+	topic string
+	mid   string
+}
+
+type hoseOffers struct {
+	timeout time.Duration
+	queue   []offerItem
+	out     map[peer.ID]map[string]time.Time
+	nOut    int
+	kicking atomic.Bool
+
+	queued, sent, answered, covered, expired, stale atomic.Int64
+}
+
+// WithHoseOffers routes phase announces through the hose window as offers. Requires
+// WithHoseWindow and phase forwarding.
+func WithHoseOffers(timeout time.Duration) Option {
+	return func(ps *PubSub) error {
+		gs, ok := ps.rt.(*GossipSubRouter)
+		if !ok {
+			return fmt.Errorf("hose offers require a gossipsub router")
+		}
+		if ps.hose == nil || gs.phaseForward == nil {
+			return fmt.Errorf("hose offers require WithHoseWindow and WithPhaseForwarding first")
+		}
+		if timeout <= 0 {
+			return fmt.Errorf("hose offers need a positive timeout")
+		}
+		gs.hoseOffers = &hoseOffers{timeout: timeout, out: make(map[peer.ID]map[string]time.Time)}
+		ps.hose.onFree = gs.kickOffers
+		return nil
+	}
+}
+
+// offerLater queues an announce of mid to p. Router goroutine.
+func (gs *GossipSubRouter) offerLater(p peer.ID, topic, mid string) {
+	o := gs.hoseOffers
+	o.queue = append(o.queue, offerItem{p: p, topic: topic, mid: mid})
+	o.queued.Add(1)
+	gs.kickOffers()
+}
+
+// kickOffers schedules one pump on the router goroutine; callable from any goroutine, including
+// under the hose window's lock, since it only starts a goroutine.
+func (gs *GossipSubRouter) kickOffers() {
+	o := gs.hoseOffers
+	if o == nil || !o.kicking.CompareAndSwap(false, true) {
+		return
+	}
+	go func() {
+		select {
+		case gs.p.eval <- gs.pumpOffers:
+		case <-gs.p.ctx.Done():
+		}
+	}()
+}
+
+// pumpOffers sends queued offers while the window has room. Router goroutine.
+func (gs *GossipSubRouter) pumpOffers() {
+	o := gs.hoseOffers
+	o.kicking.Store(false)
+	h := gs.p.hose
+	for len(o.queue) > 0 {
+		it := o.queue[0]
+		if gs.offerStale(it) {
+			o.queue = o.queue[1:]
+			o.stale.Add(1)
+			continue
+		}
+		if float64(o.nOut) >= h.free()/o.pa() {
+			return
+		}
+		o.queue = o.queue[1:]
+		ids := gs.haveIHaveIDs(it.p, []string{it.mid})
+		if len(ids) == 0 {
+			o.stale.Add(1)
+			continue
+		}
+		ihave := rpcWithControl(nil, []*pb.ControlIHave{{TopicID: &it.topic, MessageIDs: ids}}, nil, nil, nil, nil)
+		ihave.urgent = gs.haveAnnounceUrgent()
+		byMid := o.out[it.p]
+		if byMid == nil {
+			byMid = make(map[string]time.Time)
+			o.out[it.p] = byMid
+		}
+		at := time.Now()
+		byMid[it.mid] = at
+		o.nOut++
+		o.sent.Add(1)
+		gs.sendRPC(it.p, ihave, ihave.urgent)
+		gs.haveOriginOffered(it.mid)
+		p, mid := it.p, it.mid
+		time.AfterFunc(o.timeout, func() {
+			select {
+			case gs.p.eval <- func() { gs.offerDone(p, mid, at, &o.expired) }:
+			case <-gs.p.ctx.Done():
+			}
+		})
+	}
+}
+
+// offerStale reports whether an offer no longer needs to go: the peer holds the frame, or has
+// gone.
+func (gs *GossipSubRouter) offerStale(it offerItem) bool {
+	if _, ok := gs.peers[it.p]; !ok {
+		return true
+	}
+	if _, ok := gs.unwanted[it.p][computeChecksum(it.mid)]; ok {
+		return true
+	}
+	return gs.announcedHolder(it.mid, it.p)
+}
+
+// offerDone closes an outstanding offer and kicks the pump; at, when set, must match the offer
+// (a timeout for an offer already closed and re-sent does nothing). Router goroutine.
+func (gs *GossipSubRouter) offerDone(p peer.ID, mid string, at time.Time, count *atomic.Int64) {
+	o := gs.hoseOffers
+	if o == nil {
+		return
+	}
+	t, ok := o.out[p][mid]
+	if !ok || (!at.IsZero() && !t.Equal(at)) {
+		return
+	}
+	delete(o.out[p], mid)
+	o.nOut--
+	count.Add(1)
+	gs.kickOffers()
+}
+
+// pa is the share of closed offers the peer answered, floored so offers never stop entirely;
+// 0.25 until enough have closed to say.
+func (o *hoseOffers) pa() float64 {
+	answered := float64(o.answered.Load())
+	closed := answered + float64(o.covered.Load()+o.expired.Load())
+	if closed < 32 {
+		return 0.25
+	}
+	return math.Max(0.05, answered/closed)
+}
+
+// offerAnswered and offerCovered close an offer on the peer's ask and on its HAVE.
+func (gs *GossipSubRouter) offerAnswered(p peer.ID, mid string) {
+	if gs.hoseOffers != nil {
+		gs.offerDone(p, mid, time.Time{}, &gs.hoseOffers.answered)
+	}
+}
+
+func (gs *GossipSubRouter) offerCovered(p peer.ID, mid string) {
+	if gs.hoseOffers != nil {
+		gs.offerDone(p, mid, time.Time{}, &gs.hoseOffers.covered)
+	}
+}
+
+// OfferStat is one node's offer counters under the hose window.
+type OfferStat struct {
+	Queued, Sent, Answered, Covered, Expired, Stale int64
+}
+
+// HoseOfferStats reads the node's offer counters; ok is false when offers are not gated.
+func (p *PubSub) HoseOfferStats() (OfferStat, bool) {
+	gs, ok := p.rt.(*GossipSubRouter)
+	if !ok || gs.hoseOffers == nil {
+		return OfferStat{}, false
+	}
+	o := gs.hoseOffers
+	return OfferStat{Queued: o.queued.Load(), Sent: o.sent.Load(), Answered: o.answered.Load(),
+		Covered: o.covered.Load(), Expired: o.expired.Load(), Stale: o.stale.Load()}, true
+}
diff -ruN -x BUILD.bazel -x sign.go -x '*.orig' base/hose_test.go fork/hose_test.go
--- base/hose_test.go	1970-01-01 01:00:00.000000000 +0100
+++ fork/hose_test.go	2026-10-22 13:36:32.091069297 +0200
@@ -0,0 +1,164 @@
+package pubsub
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/libp2p/go-libp2p/core/peer"
+)
+
+func newTestHose(passive bool) *hoseWindow {
+	cfg := HoseConfig{Target: 20 * time.Millisecond, Kp: 0.1, Init: 2, Min: 1, Max: 8, Timeout: time.Second, Passive: passive}
+	return &hoseWindow{cfg: cfg, w: cfg.Init, wLo: cfg.Init, wHi: cfg.Init}
+}
+
+func TestHoseWindow(t *testing.T) {
+	ctx := context.Background()
+	t.Run("gates at the window and wakes on release", func(t *testing.T) {
+		h := newTestHose(false)
+		for range 2 {
+			if ok, err := h.acquire(ctx, nil); !ok || err != nil {
+				t.Fatalf("acquire under the window: %v %v", ok, err)
+			}
+		}
+		got := make(chan bool, 1)
+		go func() {
+			ok, _ := h.acquire(ctx, nil)
+			got <- ok
+		}()
+		select {
+		case <-got:
+			t.Fatal("third acquire passed a window of 2")
+		case <-time.After(20 * time.Millisecond):
+		}
+		h.release(20*time.Millisecond, true, false) // on target: W unchanged, one slot back
+		if ok := <-got; !ok {
+			t.Fatal("waiter not granted on release")
+		}
+		if h.inflight != 2 {
+			t.Fatalf("inflight %d, want 2", h.inflight)
+		}
+	})
+	t.Run("delay under target opens the window, over target closes it", func(t *testing.T) {
+		h := newTestHose(false)
+		_, _ = h.acquire(ctx, nil)
+		h.release(0, true, false) // 20 ms under: +2
+		if h.w != 4 {
+			t.Fatalf("w %.2f after an early ack, want 4", h.w)
+		}
+		_, _ = h.acquire(ctx, nil)
+		h.release(100*time.Millisecond, true, false) // 80 ms over: -8, clamped at Min
+		if h.w != 1 {
+			t.Fatalf("w %.2f after a late ack, want the floor 1", h.w)
+		}
+		if h.acks != 2 || len(h.samples) != 2 {
+			t.Fatalf("acks %d samples %d, want 2 and 2", h.acks, len(h.samples))
+		}
+	})
+	t.Run("passive never blocks and still steps", func(t *testing.T) {
+		h := newTestHose(true)
+		for range 20 {
+			if ok, _ := h.acquire(ctx, nil); !ok {
+				t.Fatal("passive window blocked")
+			}
+		}
+		h.release(0, true, false)
+		if h.inflight != 19 || h.w != 4 {
+			t.Fatalf("inflight %d w %.2f, want 19 and 4", h.inflight, h.w)
+		}
+	})
+	t.Run("a stats reset keeps the window and the frames in flight", func(t *testing.T) {
+		h := newTestHose(false)
+		ps := &PubSub{hose: h}
+		_, _ = h.acquire(ctx, nil)
+		_, _ = h.acquire(ctx, nil)
+		h.release(0, true, true) // +2: w 4, one frame still out
+		ps.ResetHoseStats()
+		s, _ := ps.HoseStats()
+		if s.W != 4 || s.WLo != 4 || s.WHi != 4 || s.Acks != 0 || s.Answers != 0 || s.PeakInflight != 1 || h.inflight != 1 {
+			t.Fatalf("after reset %+v inflight %d, want w 4 range 4..4, no acks or answers, peak and inflight 1", s, h.inflight)
+		}
+	})
+	t.Run("a freed slot goes to the lowest class waiting, first come within it", func(t *testing.T) {
+		h := newTestHose(false)
+		_, _ = h.acquire(ctx, nil)
+		_, _ = h.acquire(ctx, nil)
+		order := make(chan string, 3)
+		queued := 0
+		wait := func(name string, cls int) {
+			go func() {
+				if ok, _ := h.acquireClass(ctx, nil, cls); ok {
+					order <- name
+				}
+			}()
+			queued++
+			for { // queue the waiters in a known order
+				h.mu.Lock()
+				n := len(h.waiters)
+				h.mu.Unlock()
+				if n == queued {
+					break
+				}
+				time.Sleep(time.Millisecond)
+			}
+		}
+		wait("b1", 1)
+		wait("a1", 0)
+		wait("a2", 0)
+		var got []string
+		for range 3 {
+			h.release(20*time.Millisecond, true, false)
+			got = append(got, <-order)
+		}
+		if strings.Join(got, " ") != "a1 a2 b1" {
+			t.Fatalf("grant order %v, want a1 a2 b1", got)
+		}
+	})
+	t.Run("an unused slot and a timeout give the slot back", func(t *testing.T) {
+		h := newTestHose(false)
+		_, _ = h.acquire(ctx, nil)
+		_, _ = h.acquire(ctx, nil)
+		h.unused()
+		h.release(0, false, false)
+		if h.inflight != 0 || h.timeouts != 1 || h.w != 2 {
+			t.Fatalf("inflight %d timeouts %d w %.2f, want 0, 1 and 2", h.inflight, h.timeouts, h.w)
+		}
+	})
+}
+
+func TestHoseLateAckSamples(t *testing.T) {
+	q := newRpcQueue(16)
+	q.enableHave(testQueueIndex, true, false)
+	h := newTestHose(false) // target 20 ms, Kp 0.1, window 2
+	h.cfg.Timeout = 50 * time.Millisecond
+	h.cfg.BaseRTT = func(peer.ID) time.Duration { return time.Millisecond } // as the transport's min RTT would
+	q.hose = h
+	root := strings.Repeat("g", 32)
+	if err := q.Push(testDataRPC(root, 3), false); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(t.Context(), time.Second)
+	defer cancel()
+	if _, err := q.Pop(ctx); err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(80 * time.Millisecond) // past the timeout: the slot is back, the frame expired
+	h.mu.Lock()
+	inflight, timeouts := h.inflight, h.timeouts
+	h.mu.Unlock()
+	if inflight != 0 || timeouts != 1 {
+		t.Fatalf("after the timeout inflight %d timeouts %d, want 0 and 1", inflight, timeouts)
+	}
+	q.queueMu.Lock()
+	q.hoseAckedLocked(root, []uint32{3}, time.Time{}, nil) // the late acknowledgement
+	q.queueMu.Unlock()
+	s, _ := (&PubSub{hose: h}).HoseStats()
+	if s.LateAcks != 1 || s.Acks != 0 || h.inflight != 0 {
+		t.Fatalf("late acks %d acks %d inflight %d, want 1, 0 and 0: sampled, no second release", s.LateAcks, s.Acks, h.inflight)
+	}
+	if s.W >= 2 {
+		t.Fatalf("a delay of ~80 ms over a 20 ms target must close the window, W %.2f", s.W)
+	}
+}
diff -ruN -x BUILD.bazel -x sign.go -x '*.orig' base/ihaveobs.go fork/ihaveobs.go
--- base/ihaveobs.go	1970-01-01 01:00:00.000000000 +0100
+++ fork/ihaveobs.go	2026-10-22 13:36:32.091491981 +0200
@@ -0,0 +1,141 @@
+package pubsub
+
+import (
+	"fmt"
+	"sync/atomic"
+
+	"github.com/libp2p/go-libp2p/core/peer"
+)
+
+// --- Announce-rate observation (measurement only) ---
+//
+// MaxIHaveMessages is compared against peerhave[p]: how many RPCs carrying *any* control message
+// arrived from p within one heartbeat (HandleRPC returns early only when an RPC has no control at
+// all, so a data push with piggybacked control counts too). Phase forwarding emits one RPC per
+// (message, peer) for its announcements, so that count scales with the group size while the limit
+// was sized for heartbeat gossip's single RPC per peer per heartbeat. Nothing recorded what the
+// count actually is. This records it, per (peer, heartbeat) pair, and separately how many of those
+// RPCs carried an IHAVE at all, which is the difference between an announcement problem and a
+// control-traffic problem. It decides nothing.
+
+// ihaveBuckets is the histogram width; the last bucket is "that many or more".
+const ihaveBuckets = 256
+
+// IHaveRPCStats is a histogram over (peer, heartbeat) pairs. Safe for concurrent use, and shared
+// by every node of a cell so one snapshot describes the whole population.
+type IHaveRPCStats struct {
+	all    [ihaveBuckets]atomic.Int64 // RPCs bearing any control, which is what the limit counts
+	ihave  [ihaveBuckets]atomic.Int64 // of those, the ones that actually carried an IHAVE
+	pairs  atomic.Int64
+	rpcs   atomic.Int64
+	ihaves atomic.Int64
+	maxAll atomic.Int64
+	maxIH  atomic.Int64
+}
+
+// Reset drops everything recorded so far. The harness calls it at publish, so the histogram
+// describes the measured diffusion rather than the mesh-settle heartbeats before it.
+func (s *IHaveRPCStats) Reset() {
+	if s == nil {
+		return
+	}
+	for i := range s.all {
+		s.all[i].Store(0)
+		s.ihave[i].Store(0)
+	}
+	s.pairs.Store(0)
+	s.rpcs.Store(0)
+	s.ihaves.Store(0)
+	s.maxAll.Store(0)
+	s.maxIH.Store(0)
+}
+
+func (s *IHaveRPCStats) observe(all, ihave int) {
+	if s == nil || all <= 0 {
+		return
+	}
+	s.pairs.Add(1)
+	s.rpcs.Add(int64(all))
+	s.ihaves.Add(int64(ihave))
+	s.all[min(all, ihaveBuckets-1)].Add(1)
+	s.ihave[min(ihave, ihaveBuckets-1)].Add(1)
+	for cur := s.maxAll.Load(); int64(all) > cur && !s.maxAll.CompareAndSwap(cur, int64(all)); cur = s.maxAll.Load() {
+	}
+	for cur := s.maxIH.Load(); int64(ihave) > cur && !s.maxIH.CompareAndSwap(cur, int64(ihave)); cur = s.maxIH.Load() {
+	}
+}
+
+// Quantile returns the q-th quantile of the per-(peer, heartbeat) RPC count; ihaveOnly restricts it
+// to RPCs that carried an IHAVE.
+func (s *IHaveRPCStats) Quantile(q float64, ihaveOnly bool) int {
+	b := &s.all
+	if ihaveOnly {
+		b = &s.ihave
+	}
+	total := int64(0)
+	for i := range b {
+		total += b[i].Load()
+	}
+	if total == 0 {
+		return 0
+	}
+	want, seen := int64(float64(total)*q), int64(0)
+	for i := range b {
+		seen += b[i].Load()
+		if seen > want {
+			return i
+		}
+	}
+	return ihaveBuckets - 1
+}
+
+// Over returns the share of (peer, heartbeat) pairs whose count exceeded n, which is the share the
+// limit would have silently truncated at MaxIHaveMessages = n.
+func (s *IHaveRPCStats) Over(n int, ihaveOnly bool) float64 {
+	b := &s.all
+	if ihaveOnly {
+		b = &s.ihave
+	}
+	total, over := int64(0), int64(0)
+	for i := range b {
+		c := b[i].Load()
+		total += c
+		if i > n {
+			over += c
+		}
+	}
+	if total == 0 {
+		return 0
+	}
+	return float64(over) / float64(total)
+}
+
+// Line renders the histogram for a cell's report.
+func (s *IHaveRPCStats) Line() string {
+	if s == nil || s.pairs.Load() == 0 {
+		return "announce rate: no (peer, heartbeat) pairs observed"
+	}
+	return fmt.Sprintf("announce rate: %d (peer, heartbeat) pairs, %d control RPCs (%d carrying IHAVE); "+
+		"control RPCs per peer per heartbeat p50 %d p90 %d p99 %d max %d, over 10: %.1f%%; "+
+		"IHAVE-bearing p50 %d p90 %d p99 %d max %d, over 10: %.1f%%",
+		s.pairs.Load(), s.rpcs.Load(), s.ihaves.Load(),
+		s.Quantile(0.5, false), s.Quantile(0.9, false), s.Quantile(0.99, false), s.maxAll.Load(), 100*s.Over(10, false),
+		s.Quantile(0.5, true), s.Quantile(0.9, true), s.Quantile(0.99, true), s.maxIH.Load(), 100*s.Over(10, true))
+}
+
+// WithIHaveRPCObservation records the announce rate into stats. It records; it never decides, and
+// the limit itself is untouched.
+func WithIHaveRPCObservation(stats *IHaveRPCStats) Option {
+	return func(ps *PubSub) error {
+		gs, ok := ps.rt.(*GossipSubRouter)
+		if !ok {
+			return fmt.Errorf("announce-rate observation requires a gossipsub router")
+		}
+		if stats == nil {
+			return fmt.Errorf("announce-rate observation requires a non-nil histogram")
+		}
+		gs.ihaveObs = stats
+		gs.peerhaveIHave = make(map[peer.ID]int)
+		return nil
+	}
+}
diff -ruN -x BUILD.bazel -x sign.go -x '*.orig' base/linkdisclose.go fork/linkdisclose.go
--- base/linkdisclose.go	1970-01-01 01:00:00.000000000 +0100
+++ fork/linkdisclose.go	2026-10-22 13:36:32.092065490 +0200
@@ -0,0 +1,639 @@
+package pubsub
+
+import (
+	"fmt"
+	"sort"
+	"sync/atomic"
+	"time"
+
+	pb "github.com/libp2p/go-libp2p-pubsub/pb"
+	"github.com/libp2p/go-libp2p/core/peer"
+)
+
+// --- Link-local disclosure (privacy) ---
+//
+// Cut-through makes the source the only node whose holding is complete before it forwards
+// anything, and a HAVE bitmap tells every mesh peer the whole holding, so every honest per-frame
+// announcement marks the source to its mesh. Under link-local disclosure every node, source and
+// relay alike, limits what it reveals of a group to each peer until it completes the group. Per
+// directed link and group it keeps a monotone disclosed set, and every channel that names held
+// frames draws from it: HAVE bitmaps (alone, parked, attached, hose acknowledgements), phase and
+// heartbeat IHAVEs, and the frames it serves that peer by IWANT. The frames exchanged with the
+// peer (received from it, pushed to it) are always disclosed once held, and count; other held
+// frames join, in index order as a message names them, while the union is below the budget, so a
+// link's disclosure grows no faster than the node's own holding and passes the budget only by
+// exchanged frames. From completion on (need frames held, or a decode claim) the node discloses
+// normally.
+//
+// The source has no completion at publish. It counts its own frames as received when its writers
+// pop them (WithOriginHavePaced, lead HAVE included), announces each frame to its phase-announce
+// peers at that pop, as a relay announces at receipt, and completes at need pops, when its HAVE
+// names the whole group, as a decoding relay's does.
+//
+// Origin dilution (WithOriginDilute) applies the same cut to the groups a node publishes only,
+// with a budget that grows with time since publish and a completion at a set pace instead of at
+// need pops, so the source's per-link HAVE follows a hop-one relay's curve.
+
+// DisclosureStats counts what link-local disclosure did, for a harness's known answer. Safe for
+// concurrent use; Reset clears it between measurements.
+type DisclosureStats struct {
+	// MaxShown is the largest disclosed union on one link when its node completed the group,
+	// exchanged frames included; OverBudget counts the links where that passed the budget, which
+	// only exchanged frames can do; MaxTraded is the most frames exchanged on one link by then and
+	// MaxBeyond the most disclosed beyond them, at most the budget. Links is the links counted,
+	// Completed the (node, group) completions.
+	MaxShown, OverBudget, MaxTraded, MaxBeyond, Links, Completed atomic.Int64
+	// Withheld is the indices cut from outgoing HAVE and IHAVE bitmaps before completion, Refused
+	// the IWANT asks for undisclosed frames left unanswered, Deferred the source's phase announces
+	// held back to their frame's pop.
+	Withheld, Refused, Deferred atomic.Int64
+}
+
+// Reset clears every counter.
+func (s *DisclosureStats) Reset() {
+	for _, c := range []*atomic.Int64{&s.MaxShown, &s.OverBudget, &s.MaxTraded, &s.MaxBeyond, &s.Links, &s.Completed, &s.Withheld, &s.Refused, &s.Deferred} {
+		c.Store(0)
+	}
+}
+
+// storeMax raises c to v.
+func storeMax(c *atomic.Int64, v int64) {
+	for {
+		cur := c.Load()
+		if v <= cur || c.CompareAndSwap(cur, v) {
+			return
+		}
+	}
+}
+
+// linkDisclosure is WithLinkDisclosure's state, router-owned.
+type linkDisclosure struct {
+	budget int
+	need   int
+	stats  *DisclosureStats
+	// links is, per peer and group not yet completed, what we have disclosed to the peer and
+	// exchanged with it; done is the groups we completed, each with the hold TTL in heartbeats, and
+	// told those we publish whose whole-group HAVE has gone to the mesh.
+	links map[peer.ID]map[string]*discloseLink
+	done  map[string]int
+	told  map[string]bool
+	// announce is, for frames of a group we publish, the phase announces waiting for the pop.
+	announce map[string]*discloseAnnounce
+	// pace > 0 is WithOriginDilute: only groups we publish are limited, each from start, its
+	// publish time, with a budget growing to need at pace, when the group completes.
+	pace  time.Duration
+	start map[string]time.Time
+	// count > 0 is the group's frame count, which completion names whole, as a completed relay's
+	// HAVE (HaveAll) does.
+	count uint32
+}
+
+// diluteTick is how often a diluted group's links are offered what their budget has grown by.
+const diluteTick = 5 * time.Millisecond
+
+// discloseLink is one (peer, group): the indices disclosed to the peer and those exchanged with it.
+type discloseLink struct {
+	shown  haveBits
+	traded haveBits
+	ttl    int
+}
+
+// and is the frames of b that held has too; held may be nil.
+func (b *haveBits) and(held *haveBits) *haveBits {
+	out := &haveBits{b: append([]byte(nil), b.Bytes()...)}
+	for i := range out.b {
+		if held != nil && i < len(held.b) {
+			out.b[i] &= held.b[i]
+		} else {
+			out.b[i] = 0
+		}
+	}
+	return out
+}
+
+// union is what p has been told of the group: the disclosed frames and the held frames exchanged
+// with it, named yet or not.
+func (l *discloseLink) union(held *haveBits) *haveBits {
+	out := l.traded.and(held)
+	out.Or(l.shown.Bytes())
+	return out
+}
+
+// discloseAnnounce is one frame's deferred phase announce.
+type discloseAnnounce struct {
+	topic string
+	peers []peer.ID
+	ttl   int
+}
+
+// WithLinkDisclosure limits what this node discloses of a group to each peer, until it holds need
+// frames of the group, to budget frames beyond those exchanged with that peer (the section
+// above). stats, when non-nil, counts what the limit did. Requires WithHaveBitmaps and
+// WithOriginHavePaced: the source's holding is what its writers have popped.
+func WithLinkDisclosure(budget, need int, stats *DisclosureStats) Option {
+	return func(ps *PubSub) error {
+		gs, ok := ps.rt.(*GossipSubRouter)
+		if !ok {
+			return fmt.Errorf("link disclosure requires a gossipsub router")
+		}
+		if gs.have == nil || gs.have.originPaced == nil || gs.have.originPaced.mode != OriginHavePaced {
+			return fmt.Errorf("link disclosure requires WithHaveBitmaps and WithOriginHavePaced first")
+		}
+		if budget < 1 || need < 1 {
+			return fmt.Errorf("link disclosure requires budget >= 1 and need >= 1")
+		}
+		if stats == nil {
+			stats = &DisclosureStats{}
+		}
+		gs.have.disclose = &linkDisclosure{
+			budget: budget, need: need, stats: stats,
+			links:    make(map[peer.ID]map[string]*discloseLink),
+			done:     make(map[string]int),
+			told:     make(map[string]bool),
+			announce: make(map[string]*discloseAnnounce),
+		}
+		return nil
+	}
+}
+
+// WithOriginDilute limits, per peer, what this node discloses of each group it publishes to what
+// a relay one hop out could hold: the frames exchanged with the peer, then held frames in one
+// pseudo-random order for all links, up to a count that grows to need frames pace after publish,
+// when the group completes and the HAVE names it whole, as a decoding relay's does. Relayed
+// groups are disclosed normally. count > 0 is the group's frame count, which the completing HAVE
+// names, for a network whose completed relays name every frame (HaveAll). Every channel is cut as
+// under WithLinkDisclosure, which it excludes. Requires WithHaveBitmaps and WithOriginHavePaced.
+func WithOriginDilute(pace time.Duration, need int, count uint32, stats *DisclosureStats) Option {
+	return func(ps *PubSub) error {
+		gs, ok := ps.rt.(*GossipSubRouter)
+		if !ok {
+			return fmt.Errorf("origin dilution requires a gossipsub router")
+		}
+		if gs.have == nil || gs.have.originPaced == nil || gs.have.originPaced.mode != OriginHavePaced {
+			return fmt.Errorf("origin dilution requires WithHaveBitmaps and WithOriginHavePaced first")
+		}
+		if gs.have.disclose != nil {
+			return fmt.Errorf("origin dilution excludes WithLinkDisclosure")
+		}
+		if pace <= 0 || need < 1 {
+			return fmt.Errorf("origin dilution requires pace > 0 and need >= 1")
+		}
+		if stats == nil {
+			stats = &DisclosureStats{}
+		}
+		gs.have.disclose = &linkDisclosure{
+			budget: need, need: need, stats: stats, pace: pace, count: count,
+			links:    make(map[peer.ID]map[string]*discloseLink),
+			done:     make(map[string]int),
+			told:     make(map[string]bool),
+			announce: make(map[string]*discloseAnnounce),
+			start:    make(map[string]time.Time),
+		}
+		return nil
+	}
+}
+
+// scoped reports whether disclosure limits root: every group, or under dilution only ours.
+func (d *linkDisclosure) scoped(root string) bool {
+	if d.pace == 0 {
+		return true
+	}
+	_, ok := d.start[root]
+	return ok
+}
+
+// budgetFor is how many frames of root a link may be told beyond its exchanges: the fixed budget,
+// or under dilution the share of need that the time since publish is of pace, below need until
+// completion.
+func (d *linkDisclosure) budgetFor(root string) int {
+	if d.pace == 0 {
+		return d.budget
+	}
+	n := int(int64(d.need) * int64(time.Since(d.start[root])) / int64(d.pace))
+	return min(max(n, 0), d.need-1)
+}
+
+// owns reports whether root is a group we publish.
+func (o *originPaced) owns(root string) bool {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	return o.roots[root] != nil
+}
+
+// isDone reports whether we completed root.
+func (d *linkDisclosure) isDone(root string) bool {
+	_, ok := d.done[root]
+	return ok
+}
+
+// link is p's state for root, created with the hold TTL when missing.
+func (d *linkDisclosure) link(p peer.ID, root string, ttl int) *discloseLink {
+	roots := d.links[p]
+	if roots == nil {
+		roots = make(map[string]*discloseLink)
+		d.links[p] = roots
+	}
+	l := roots[root]
+	if l == nil {
+		l = &discloseLink{}
+		roots[root] = l
+	}
+	l.ttl = ttl
+	return l
+}
+
+// discloseDone reports whether we completed root, recording the completion the first time what
+// we hold of it reaches need: every link's disclosed set is counted and dropped. Router goroutine.
+func (gs *GossipSubRouter) discloseDone(root string) bool {
+	d := gs.have.disclose
+	if d.isDone(root) || !d.scoped(root) {
+		return true
+	}
+	if d.pace > 0 && time.Since(d.start[root]) < d.pace {
+		return false
+	}
+	held := gs.have.haveBitsFor(root)
+	if held == nil || held.Count() < d.need {
+		return false
+	}
+	d.done[root] = gs.have.holdTTL
+	s := d.stats
+	s.Completed.Add(1)
+	for p, roots := range d.links {
+		l := roots[root]
+		if l == nil {
+			continue
+		}
+		n := l.union(held).Count()
+		storeMax(&s.MaxShown, int64(n))
+		storeMax(&s.MaxTraded, int64(l.traded.and(held).Count()))
+		storeMax(&s.MaxBeyond, int64(l.shown.AndNot(&l.traded).Count()))
+		s.Links.Add(1)
+		if n > d.budget {
+			s.OverBudget.Add(1)
+		}
+		delete(roots, root)
+		if len(roots) == 0 {
+			delete(d.links, p)
+		}
+	}
+	return true
+}
+
+// discloseTells reports whether a tell of our pops of root, a group we publish, goes to the mesh:
+// each until the first after completion, which names the whole group as a decoder's HAVE does;
+// later pops add nothing to say. Router goroutine, from haveOriginTell.
+func (gs *GossipSubRouter) discloseTells(root string) bool {
+	d := gs.have.disclose
+	if d.told[root] {
+		return false
+	}
+	if gs.discloseDone(root) {
+		d.told[root] = true
+	}
+	return true
+}
+
+// discloseBits is bits, a bitmap of root about to be named to p, cut to what p may be told: what
+// was disclosed to it before, the held frames exchanged with it, and further held frames in index
+// order while that union is below the budget, which grows by what it admits. bits itself when
+// disclosure is off or we completed root. Router goroutine.
+func (gs *GossipSubRouter) discloseBits(p peer.ID, root string, bits *haveBits) *haveBits {
+	h := gs.have
+	d := h.disclose
+	if d == nil || bits == nil || gs.discloseDone(root) {
+		return bits
+	}
+	held := h.haveBitsFor(root)
+	l := d.links[p][root]
+	switch {
+	case l != nil:
+		l.ttl = h.holdTTL
+	case held == nil:
+		d.stats.Withheld.Add(int64(bits.Count()))
+		return &haveBits{} // nothing held and nothing disclosed yet
+	default:
+		l = d.link(p, root, h.holdTTL)
+	}
+	has := func(i uint32) bool { return bits.Has(i) && held != nil && held.Has(i) && !l.shown.Has(i) }
+	union := l.union(held)
+	n := union.Count()
+	for i := uint32(0); i < uint32(len(bits.b))*8; i++ { // lint:ignore uintcast -- bounded by haveMaxBytes*8.
+		if has(i) && l.traded.Has(i) {
+			l.shown.Set(i) // in the union already
+		}
+	}
+	budget := d.budgetFor(root)
+	var admit []uint32
+	for i := uint32(0); i < uint32(len(bits.b))*8; i++ { // lint:ignore uintcast -- bounded by haveMaxBytes*8.
+		if has(i) && !union.Has(i) {
+			admit = append(admit, i)
+		}
+	}
+	if d.pace > 0 {
+		// One order for every link, so each hears a prefix of it: a relay's one holding, which is
+		// what reached it rather than a prefix of the index space.
+		sort.Slice(admit, func(x, y int) bool { return pairRank(root, admit[x], "", "") < pairRank(root, admit[y], "", "") })
+	}
+	for _, i := range admit {
+		if n >= budget {
+			break
+		}
+		l.shown.Set(i)
+		n++
+	}
+	out := bits.and(&l.shown)
+	if cut := bits.Count() - out.Count(); cut > 0 {
+		d.stats.Withheld.Add(int64(cut))
+	}
+	return out
+}
+
+// discloseTraded records that p and we exchanged mid: p sent it to us, or we push it to p.
+// Router goroutine.
+func (gs *GossipSubRouter) discloseTraded(p peer.ID, mid string) {
+	h := gs.have
+	if h == nil || h.disclose == nil || (gs.p != nil && p == gs.p.host.ID()) {
+		return
+	}
+	root, index, ok := h.index(mid)
+	if !ok || len(root) != haveRootLen || h.disclose.isDone(root) || !h.disclose.scoped(root) {
+		return
+	}
+	h.disclose.link(p, root, h.holdTTL).traded.Set(index)
+}
+
+// discloseLead discloses to p the frame of a group we publish that our lead HAVE names ahead of
+// pushing it: an exchanged frame, named just before it is popped. Router goroutine.
+func (gs *GossipSubRouter) discloseLead(p peer.ID, root string, index uint32) {
+	h := gs.have
+	if h.disclose == nil || h.disclose.isDone(root) {
+		return
+	}
+	h.disclose.link(p, root, h.holdTTL).shown.Set(index)
+}
+
+// discloseRefuses reports whether an IWANT from p for mid, a frame we hold, goes unanswered: the
+// frame is of a group we have not completed and was neither disclosed to p nor exchanged with it.
+// Serving it would disclose it. Router goroutine.
+func (gs *GossipSubRouter) discloseRefuses(p peer.ID, mid string) bool {
+	h := gs.have
+	if h == nil || h.disclose == nil {
+		return false
+	}
+	root, index, ok := h.index(mid)
+	if !ok || len(root) != haveRootLen || gs.discloseDone(root) {
+		return false
+	}
+	if l := h.disclose.links[p][root]; l != nil && (l.shown.Has(index) || l.traded.Has(index)) {
+		return false
+	}
+	h.disclose.stats.Refused.Add(1)
+	return true
+}
+
+// discloseDefer holds back, for a frame of a group we publish and have not completed, the phase
+// announce to peers until our writers pop the frame; reports whether it did. Router goroutine.
+func (gs *GossipSubRouter) discloseDefer(topic, mid string, peers []peer.ID) bool {
+	h := gs.have
+	if h == nil || h.disclose == nil || len(peers) == 0 {
+		return false
+	}
+	root, _, ok := h.index(mid)
+	if !ok || len(root) != haveRootLen || h.disclose.isDone(root) || !h.originPaced.owns(root) {
+		return false
+	}
+	a := h.disclose.announce[mid]
+	if a == nil {
+		a = &discloseAnnounce{topic: topic}
+		h.disclose.announce[mid] = a
+	}
+	a.peers = append(a.peers, peers...)
+	a.ttl = h.holdTTL
+	h.disclose.stats.Deferred.Add(int64(len(peers)))
+	return true
+}
+
+// discloseAnnounce sends the phase announces held back for mids, frames our writers just popped,
+// as rpcs sends a relay's. Router goroutine, from haveOriginTell.
+func (gs *GossipSubRouter) discloseAnnounce(mids []string) {
+	d := gs.have.disclose
+	for _, mid := range mids {
+		a := d.announce[mid]
+		if a == nil {
+			continue
+		}
+		delete(d.announce, mid)
+		csum := computeChecksum(mid)
+		for _, pid := range a.peers {
+			if _, ok := gs.p.peers[pid]; !ok {
+				continue
+			}
+			if _, ok := gs.unwanted[pid][csum]; ok {
+				continue
+			}
+			if gs.hoseOffers != nil {
+				gs.offerLater(pid, a.topic, mid)
+				continue
+			}
+			ids := gs.haveIHaveIDs(pid, []string{mid})
+			if len(ids) == 0 {
+				continue
+			}
+			topic := a.topic
+			ihave := rpcWithControl(nil, []*pb.ControlIHave{{TopicID: &topic, MessageIDs: ids}}, nil, nil, nil, nil)
+			ihave.urgent = gs.haveAnnounceUrgent()
+			gs.sendRPC(pid, ihave, ihave.urgent)
+		}
+	}
+}
+
+// discloseID is the control id mid as p may be told it: a HAVE or IHAVE bitmap cut by
+// discloseBits, a per-id structured id kept or dropped, anything else (a claim, a receive stamp,
+// an unstructured id) as it is; keep is false when nothing of it may go.
+func (gs *GossipSubRouter) discloseID(p peer.ID, mid string) (out string, keep bool) {
+	h := gs.have
+	if _, _, _, ok := decodeHoseStamp(mid); ok {
+		return mid, true // it names only what p just sent us
+	}
+	if root, load, enc, ok := decodeHaveLoad(mid); ok {
+		if isHaveClaim(mid) || len(root) != haveRootLen {
+			return mid, true // a claim says "stop sending", not "I hold"
+		}
+		var b haveBits
+		b.Or(enc)
+		cut := gs.discloseBits(p, root, &b)
+		if cut == &b {
+			return mid, true
+		}
+		if cut.Count() == 0 {
+			return "", false
+		}
+		if mid[len(haveMagic)] == haveVersionLoad {
+			return encodeHaveLoad(root, load, cut), true
+		}
+		return encodeHave(root, cut), true
+	}
+	if root, index, ok := h.index(mid); ok && len(root) == haveRootLen {
+		var b haveBits
+		b.Set(index)
+		if cut := gs.discloseBits(p, root, &b); cut != &b && cut.Count() == 0 {
+			return "", false
+		}
+	}
+	return mid, true
+}
+
+// applyDisclosure returns rpc with every HAVE and IHAVE naming held frames to p cut to what p may
+// be told (discloseID); nil when nothing else remains. rpc itself is never mutated, since one RPC
+// can be yielded to several peers. Router goroutine, from doSendRPC.
+func (gs *GossipSubRouter) applyDisclosure(rpc *RPC, p peer.ID) *RPC {
+	if gs.have == nil || gs.have.disclose == nil || rpc == nil {
+		return rpc
+	}
+	ctl := rpc.GetControl()
+	if ctl == nil || (len(ctl.Idontwant) == 0 && len(ctl.Ihave) == 0) {
+		return rpc
+	}
+	changed := false
+	cutIDs := func(ids []string) []string {
+		out := make([]string, 0, len(ids))
+		for _, mid := range ids {
+			id, keep := gs.discloseID(p, mid)
+			if !keep || id != mid {
+				changed = true
+			}
+			if keep {
+				out = append(out, id)
+			}
+		}
+		return out
+	}
+	var idontwant []*pb.ControlIDontWant
+	for _, e := range ctl.Idontwant {
+		if ids := cutIDs(e.MessageIDs); len(ids) > 0 {
+			idontwant = append(idontwant, &pb.ControlIDontWant{MessageIDs: ids})
+		}
+	}
+	var ihave []*pb.ControlIHave
+	for _, e := range ctl.Ihave {
+		if ids := cutIDs(e.MessageIDs); len(ids) > 0 {
+			ihave = append(ihave, &pb.ControlIHave{TopicID: e.TopicID, MessageIDs: ids})
+		}
+	}
+	if !changed {
+		return rpc
+	}
+	out := shallowRPCCopy(rpc)
+	out.urgent = rpc.urgent
+	out.Control = nil
+	if len(idontwant) > 0 || len(ihave) > 0 || len(ctl.Iwant) > 0 || len(ctl.Graft) > 0 || len(ctl.Prune) > 0 || ctl.Extensions != nil {
+		out.Control = &pb.ControlMessage{Ihave: ihave, Iwant: ctl.Iwant, Graft: ctl.Graft, Prune: ctl.Prune, Idontwant: idontwant, Extensions: ctl.Extensions}
+	}
+	if len(out.Publish) == 0 && out.Control == nil && rpcOtherwiseEmpty(out) {
+		return nil
+	}
+	return out
+}
+
+// discloseHeartbeat ages completed groups, link state and held-back announces on the hold TTL.
+func (gs *GossipSubRouter) discloseHeartbeat() {
+	d := gs.have.disclose
+	if d == nil {
+		return
+	}
+	for root, ttl := range d.done {
+		if ttl <= 1 {
+			delete(d.done, root)
+			delete(d.told, root)
+			delete(d.start, root)
+		} else {
+			d.done[root] = ttl - 1
+		}
+	}
+	for p, roots := range d.links {
+		for root, l := range roots {
+			if l.ttl--; l.ttl <= 0 {
+				delete(roots, root)
+			}
+		}
+		if len(roots) == 0 {
+			delete(d.links, p)
+		}
+	}
+	for mid, a := range d.announce {
+		if a.ttl--; a.ttl <= 0 {
+			delete(d.announce, mid)
+		}
+	}
+}
+
+// discloseOriginStart begins dilution of root, a group we publish on topic: its budget runs from
+// now, and a tick offers each mesh peer what the budget has grown by. Router goroutine, from
+// haveOriginOwn.
+func (gs *GossipSubRouter) discloseOriginStart(topic, root string) {
+	d := gs.have.disclose
+	if d == nil || d.pace == 0 || d.scoped(root) {
+		return
+	}
+	d.start[root] = time.Now()
+	gs.discloseOriginArm(topic, root)
+}
+
+// discloseOriginArm schedules the next dilution tick of root.
+func (gs *GossipSubRouter) discloseOriginArm(topic, root string) {
+	time.AfterFunc(diluteTick, func() {
+		select {
+		case gs.p.eval <- func() { gs.discloseOriginTick(topic, root) }:
+		case <-gs.p.ctx.Done():
+		}
+	})
+}
+
+// discloseOriginTick sends each mesh peer our HAVE for root when what it may be told has grown,
+// as a relay's HAVE grows with arrivals between our pops; at completion it names the whole group
+// to the mesh once, as a decoding relay's does, and stops. Router goroutine.
+func (gs *GossipSubRouter) discloseOriginTick(topic, root string) {
+	h := gs.have
+	d := h.disclose
+	if !d.scoped(root) || d.told[root] {
+		return
+	}
+	if gs.discloseDone(root) {
+		d.told[root] = true
+		if d.count > 0 {
+			gs.haveAll(topic, root, d.count)
+			return
+		}
+		if held := h.haveBitsFor(root); held != nil {
+			for p := range gs.mesh[topic] {
+				gs.discloseSendHave(p, root, held)
+			}
+		}
+		return
+	}
+	if held := h.haveBitsFor(root); held != nil {
+		for p := range gs.mesh[topic] {
+			before := 0
+			if l := d.links[p][root]; l != nil {
+				before = l.shown.and(held).Count()
+			}
+			if cut := gs.discloseBits(p, root, held); cut.Count() > before {
+				gs.discloseSendHave(p, root, cut)
+			}
+		}
+	}
+	gs.discloseOriginArm(topic, root)
+}
+
+// discloseSendHave sends p our HAVE bits for root, parked on its queue when something is queued.
+func (gs *GossipSubRouter) discloseSendHave(p peer.ID, root string, bits *haveBits) {
+	if !gs.feature(GossipSubFeatureIdontwant, gs.peers[p]) {
+		return
+	}
+	mid := encodeHave(root, bits)
+	if gs.havePendAll(p, []string{mid}) {
+		return
+	}
+	gs.sendRPC(p, rpcWithControl(nil, nil, nil, nil, nil, []*pb.ControlIDontWant{{MessageIDs: []string{mid}}}), true)
+}

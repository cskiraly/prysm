+			// The writer's copy, for frames already queued to this peer.
+			if q := gs.haveQueue(p); q != nil {
+				q.haveTheirsAt(root, enc, gs.hoseAckAt, gs.hoseAckIdx[root])
+			}
+		}
+	}

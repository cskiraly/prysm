+++ fork/havebitmap_test.go	2026-10-22 13:36:32.091069297 +0200
@@ -0,0 +1,2013 @@
+package pubsub
+
+import (
+	"context"
+	"crypto/sha256"
+	"fmt"
+	"math/rand"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"

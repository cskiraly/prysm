+			if on && (len(gs.gossipTracer.peerPromises["A"]) != 0 || len(gs.gossipTracer.peerPromises["B"]) != 0) {
+				t.Fatal("a cleared promise must leave the per-peer index too")
+			}
+		})
+	}
+}

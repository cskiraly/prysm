+	case PhaseSelectLowerHalf:
+		for i := range k {
+			j := i + intn(len(pool)-i)
+			pool[i], pool[j] = pool[j], pool[i]
+			chosen[pool[i]] = true
+			out = append(out, pool[i])
+		}

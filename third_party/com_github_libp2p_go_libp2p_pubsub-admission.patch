+			if q := gs.haveQueue(p); q != nil {
+				q.haveClaim(root, enc)
+			}
+		}
+	} else {
+		newly = e.bits.Or(enc)
+		if h.holders != nil {
+			h.holders.add(root, newly)
+		}

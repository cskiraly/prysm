diff -ruN -x BUILD.bazel -x sign.go -x '*.orig' pubsub_base/phaseforward_iwant_alloc_test.go fork/phaseforward_iwant_alloc_test.go
--- pubsub_base/phaseforward_iwant_alloc_test.go	1970-01-01 01:00:00.000000000 +0100
+++ fork/phaseforward_iwant_alloc_test.go	2026-08-31 00:55:00.469364981 +0200
